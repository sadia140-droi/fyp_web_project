            ===================================================== */


            /* =========================
               LOAD NOTIFICATIONS
            ========================== */

            async function loadCustomerNotifications() {
                if (!window.currentUserEmail || window.currentUserEmail === "guest") {
                    if (notificationBadge) notificationBadge.style.display = "none";
                    if (notificationBody) {
                        notificationBody.innerHTML = `
                            <div class="empty-cart">
                                <i class="fas fa-bell-slash"></i>
                                <p>Please login to view your notifications.</p>
                            </div>
                        `;
                    }
                    return;
                }

                try {
                    notificationBody.innerHTML = `
                        <div class="empty-cart">
                            <i class="fas fa-spinner fa-spin"></i>
                            <p>Loading notifications...</p>
                        </div>
                    `;

                    const response = await fetch("/Customer/GetNotifications?_t=" + Date.now(), {
                        method: "GET",
                        cache: "no-store",
                        credentials: "same-origin"
                    });

                    if (!response.ok) {
                        throw new Error("Notification request failed.");
                    }

                    const notifications = await response.json();


                    if (
                        !Array.isArray(
                            notifications
                        ) ||
                        notifications.length === 0
                    ) {

                        notificationBadge.style.display =
                            "none";


                        notificationBody.innerHTML = `

                            <div class="empty-cart">

                                <i class="fas fa-bell-slash"></i>

                                <p>No notifications yet.</p>

                            </div>

                        `;

                        return;

                    }


                    const unreadCount =
                        notifications.filter(
                            function (
                                notification
                            ) {

                                return String(
                                    notification.status
                                )
                                .toLowerCase() ===
                                "unread";

                            }
                        ).length;


                    updateNotificationBadge(
                        unreadCount
                    );


                    let html = "";


                    html += `

                        <div class="notification-actions">

                            <button
                                type="button"
                                class="mark-all-btn"
                                onclick="markAllCustomerNotificationsAsRead()">

                                Mark all as read

                            </button>

                        </div>

                    `;


                    notifications.forEach(
                        function (
                            notification
                        ) {

                            const isUnread =
                                String(
                                    notification.status
                                )
                                .toLowerCase() ===
                                "unread";


                            const title =
                                escapeHtml(
                                    notification.title
                                );


                            const body =
                                escapeHtml(
                                    notification.body
                                );


                            const time =
                                formatNotificationTime(
                                    notification.time
                                );


                            const icon =
                                getNotificationIcon(
                                    notification.title
                                );


                            const notificationId =
                                encodeURIComponent(
                                    notification.id
                                );


                            const hasLink =
                                notification.link &&
                                notification.link.trim() !==
                                "";


                            html += `

                                <div
                                    class="customer-notification-item
                                           ${isUnread ? "unread" : ""}
                                           ${hasLink ? "order-status" : "normal-notification"}"
                                    data-notification-id="${notificationId}"
                                    ${
                                        hasLink
                                            ? `onclick="handleCustomerNotificationClick('${notificationId}', '${encodeURIComponent(notification.link)}')"`
                                            : `onclick="markCustomerNotificationAsRead('${notificationId}')"`
                                    }>

                                    <div class="notification-icon-box">

                                        <i class="fas ${icon}"></i>

                                    </div>


                                    <div class="notification-content">

                                        <p class="notification-title">

                                            ${title}

                                        </p>

                                        <p class="notification-message">

                                            ${body}

                                        </p>

                                        <span class="notification-time">

                                            ${time}

                                        </span>

                                    </div>


                                    ${
                                        hasLink
                                            ? `

                                                <div class="notification-arrow">

                                                    <i class="fas fa-chevron-right"></i>

                                                </div>

                                              `
                                            : ""
                                    }

                                </div>

                            `;

                        }
                    );


                    notificationBody.innerHTML =
                        html;

                }
                catch (error) {

                    console.error(
                        "Notification error:",
                        error
                    );


                    notificationBadge.style.display =
                        "none";


                    notificationBody.innerHTML = `

                        <div class="empty-cart">

                            <i class="fas fa-exclamation-circle"></i>

                            <p>
                                Unable to load notifications.
                            </p>

                        </div>

                    `;

                }

            }


            /* =========================
               NOTIFICATION BADGE
            ========================== */

            function updateNotificationBadge(
                unreadCount
            ) {

                const count =
                    Number(
                        unreadCount
                    ) || 0;


                if (
                    count <= 0
                ) {

                    notificationBadge.innerText =
                        "0";

                    notificationBadge.style.display =
                        "none";

                    return;

                }


                notificationBadge.innerText =
                    count > 99
                        ? "99+"
                        : count;

                notificationBadge.style.display =
                    "flex";

            }


            /* =========================
               LOAD BADGE ON PAGE LOAD
            ========================== */

            async function loadNotificationBadge() {
                if (!window.currentUserEmail || window.currentUserEmail === "guest") {
                    if (notificationBadge) notificationBadge.style.display = "none";
                    return;
                }

                try {
                    const response = await fetch("/Customer/GetNotifications?_t=" + Date.now(), {
                        method: "GET",
                        cache: "no-store",
                        credentials: "same-origin"
                    });

                    if (!response.ok) {
                        return;
                    }

                    const notifications = await response.json();


                    if (
                        !Array.isArray(
                            notifications
                        )
                    ) {

                        return;

                    }


                    const unreadCount =
                        notifications.filter(
                            function (
                                notification
                            ) {

                                return String(
                                    notification.status
                                )
                                .toLowerCase() ===
                                "unread";

                            }
                        ).length;


                    updateNotificationBadge(
                        unreadCount
                    );

                }
                catch (error) {

                    console.error(
                        "Notification badge error:",
                        error
                    );

                }

            }


            /* =========================
               NOTIFICATION ICON
            ========================== */

            function getNotificationIcon(
                title
            ) {

                const text =
                    String(
                        title || ""
                    )
                    .toLowerCase();


                if (
                    text.includes("cancel")
                ) {

                    return "fa-circle-xmark";

                }


                if (
                    text.includes("accept")
                ) {

                    return "fa-circle-check";

                }


                if (
                    text.includes("preparing")
                ) {

                    return "fa-fire-burner";

                }


                if (
                    text.includes("ready")
                ) {

                    return "fa-bell";

                }


                if (
                    text.includes("dispatch")
                ) {

                    return "fa-truck";

                }


                if (
                    text.includes("order")
                ) {

                    return "fa-receipt";

                }


                if (
                    text.includes("offer")
                ) {

                    return "fa-tag";

                }


                if (
                    text.includes("kitchen")
                ) {

                    return "fa-store";

                }


                return "fa-bell";

            }


            /* =========================
               FORMAT TIME
            ========================== */

            function formatNotificationTime(
                dateValue
            ) {

                if (!dateValue) {

                    return "";

                }


                const date =
                    new Date(
                        dateValue
                    );


                if (
                    Number.isNaN(
                        date.getTime()
                    )
                ) {

                    return "";

                }


                const now =
                    new Date();


                const difference =
                    Math.floor(
                        (
                            now.getTime() -
                            date.getTime()
                        ) / 1000
                    );


                if (
                    difference < 60
                ) {

                    return "Just now";

                }


                const minutes =
                    Math.floor(
                        difference / 60
                    );


                if (
                    minutes < 60
                ) {

                    return minutes +
                        (
                            minutes === 1
                                ? " minute ago"
                                : " minutes ago"
                        );

                }


                const hours =
                    Math.floor(
                        minutes / 60
                    );


                if (
                    hours < 24
                ) {

                    return hours +
                        (
                            hours === 1
                                ? " hour ago"
                                : " hours ago"
                        );

                }


                const days =
                    Math.floor(
                        hours / 24
                    );


                if (
                    days < 7
                ) {

                    return days +
                        (
                            days === 1
                                ? " day ago"
                                : " days ago"
                        );

                }


                return date.toLocaleDateString();

            }


            /* =========================
               MARK ONE AS READ
            ========================== */

            window.markCustomerNotificationAsRead =
                async function (
                    notificationId
                ) {

                    try {

                        const tokenElement =
                            document.querySelector(
                                'input[name="__RequestVerificationToken"]'
                            );


                        const token =
                            tokenElement
                                ? tokenElement.value
                                : "";


                        const formData =
                            new URLSearchParams();


                        formData.append(
                            "id",
                            decodeURIComponent(
                                notificationId
                            )
                        );


                        if (token) {

                            formData.append(
                                "__RequestVerificationToken",
                                token
                            );

                        }


                        const response =
                            await fetch(
                                "/Customer/MarkAsRead",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type":
                                            "application/x-www-form-urlencoded; charset=UTF-8"
                                    },
                                    body:
                                        formData.toString(),
                                    credentials:
                                        "same-origin"
                                }
                            );


                        if (!response.ok) {

                            throw new Error(
                                "Unable to mark notification as read."
                            );

                        }


                        await loadCustomerNotifications();

                    }
                    catch (error) {

                        console.error(
                            "Mark notification read error:",
                            error
                        );

                    }

                };


