            /* =========================
               CART RENDER
            ========================== */

            window.refreshCartLayoutView = function () {
                const cart = getCart();
                const disclaimerEl = document.getElementById("customerCartDisclaimer");
                const footerEl = document.getElementById("customerCartFooter") || document.querySelector(".cart-footer");

                if (footerEl) {
                    footerEl.style.display = "none";
                }

                cartBody.innerHTML = "";

                let grandTotalQty = 0;
                const kitchenNames = Object.keys(cart).filter(k => Array.isArray(cart[k]) && cart[k].length > 0);

                if (kitchenNames.length === 0) {
                    if (disclaimerEl) disclaimerEl.style.display = "none";
                    if (cartBadge) cartBadge.style.display = "none";
                    if (cartTotal) cartTotal.innerText = "Rs. 0";

                    cartBody.innerHTML = `
                        <div class="empty-cart" style="text-align: center; padding: 60px 20px;">
                            <i class="fa-solid fa-basket-shopping" style="font-size: 3.2rem; color: #e5ded6; margin-bottom: 16px; display: block;"></i>
                            <p style="font-size: 1.15rem; font-weight: 800; color: #444; margin-bottom: 6px;">Your cart is empty</p>
                            <small style="color: #888; font-size: 0.88rem;">Add items from kitchens to start ordering</small>
                        </div>
                    `;
                    return;
                }

                if (disclaimerEl) {
                    disclaimerEl.style.display = "block";
                }

                kitchenNames.forEach(function (kitchenName) {
                    const items = cart[kitchenName];
                    const kitchenItemCount = items.reduce((sum, item) => sum + (Number(item.qty) || 1), 0);
                    const kitchenSubtotal = items.reduce((sum, item) => sum + ((Number(item.price) || 0) * (Number(item.qty) || 1)), 0);
                    
                    // Dynamic delivery fee per kilometer
                    const ratePerKm = Number(items[0]?.deliveryRatePerKm) || 30;
                    const kLat = Number(items[0]?.kitchenLat) || 0;
                    const kLng = Number(items[0]?.kitchenLng) || 0;
                    const userLat = parseFloat(localStorage.getItem("userLat") || sessionStorage.getItem("userLat") || "0");
                    const userLng = parseFloat(localStorage.getItem("userLng") || sessionStorage.getItem("userLng") || "0");

                    let distanceKm = 3.2; // default intra-city distance fallback
                    if (userLat !== 0 && userLng !== 0 && kLat !== 0 && kLng !== 0) {
                        const R = 6371;
                        const dLat = (kLat - userLat) * Math.PI / 180;
                        const dLon = (kLng - userLng) * Math.PI / 180;
                        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                                  Math.cos(userLat * Math.PI / 180) * Math.cos(kLat * Math.PI / 180) *
                                  Math.sin(dLon/2) * Math.sin(dLon/2);
                        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
                        const d = R * c;
                        if (d > 0 && d < 100) {
                            distanceKm = Math.round(d * 10) / 10;
                        }
                    }

                    const deliveryFee = Math.max(40, Math.round(distanceKm * ratePerKm));
                    const kitchenTotal = kitchenSubtotal + deliveryFee;
                    const firstKitchenId = items[0]?.kitchenId || 0;

                    grandTotalQty += kitchenItemCount;

                    const card = document.createElement("div");
                    card.className = "cart-kitchen-card";

                    let itemsHtml = items.map(function (item, index) {
                        const qty = Math.min(Math.max(Number(item.qty) || 1, 1), 100);
                        const price = Number(item.price) || 0;
                        const itemTotal = price * qty;
                        const imgSrc = item.img || item.image || "/images/default-food.jpg";

                        return `
                            <div class="cart-item-row">
                                <img class="cart-item-thumbnail" src="${escapeHtml(imgSrc)}" alt="${escapeHtml(item.name || '')}" onerror="this.src='/images/default-food.jpg';">
                                <div class="cart-item-info">
                                    <p class="cart-item-title">${escapeHtml(item.name || '')}</p>
                                    <div class="cart-item-price-tag">Rs. ${itemTotal}</div>
                                    <div class="cart-item-stepper">
                                        <button type="button" class="cart-qty-btn" data-action="minus" data-kitchen="${encodeURIComponent(kitchenName)}" data-index="${index}">−</button>
                                        <span class="cart-qty-val">${qty}</span>
                                        <button type="button" class="cart-qty-btn" data-action="plus" data-kitchen="${encodeURIComponent(kitchenName)}" data-index="${index}">+</button>
                                    </div>
                                </div>
                                <button type="button" class="cart-item-trash" data-action="delete" data-kitchen="${encodeURIComponent(kitchenName)}" data-index="${index}" title="Remove item">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </div>
                        `;
                    }).join("");

                    card.innerHTML = `
                        <!-- Kitchen Header -->
                        <div class="cart-kitchen-header">
                            <div>
                                <div class="cart-kitchen-title-box">
                                    <i class="fa-solid fa-utensils"></i>
                                    <span>${escapeHtml(kitchenName)}</span>
                                </div>
                                <div class="cart-kitchen-count">
                                    ${kitchenItemCount} ${kitchenItemCount === 1 ? 'item' : 'items'}
                                </div>
                            </div>
                            <button type="button" class="btn-clear-kitchen" data-action="clear-kitchen" data-kitchen="${encodeURIComponent(kitchenName)}">
                                Clear
                            </button>
                        </div>

                        <!-- Items List -->
                        <div style="display: flex; flex-direction: column;">
                            ${itemsHtml}
                        </div>

                        <!-- Pricing Breakdown -->
                        <div class="cart-pricing-box">
                            <div class="cart-pricing-row">
                                <span>Subtotal</span>
                                <span>Rs. ${kitchenSubtotal}</span>
                            </div>
                            <div class="cart-pricing-row">
                                <span>Delivery (${distanceKm.toFixed(1)} km @@ Rs. ${ratePerKm}/km)</span>
                                <span>Rs. ${deliveryFee}</span>
                            </div>
                            <div class="cart-pricing-row total-row">
                                <span>Total</span>
                                <span>Rs. ${kitchenTotal}</span>
                            </div>
                        </div>

                        <!-- Checkout Button -->
                        <button type="button" class="btn-kitchen-checkout" data-action="checkout-kitchen" data-kitchen="${encodeURIComponent(kitchenName)}" data-kitchen-id="${firstKitchenId}">
                            <i class="fa-solid fa-lock"></i>
                            <span>Checkout from ${escapeHtml(kitchenName)}</span>
                        </button>
                    `;

                    cartBody.appendChild(card);
                });

                if (cartBadge) {
                    cartBadge.innerText = grandTotalQty;
                    cartBadge.style.display = grandTotalQty > 0 ? "flex" : "none";
                }
            };


            /* =========================================================
               CART BODY ACTIONS: QUANTITY, DELETE, CLEAR, CHECKOUT
            ========================================================= */

            cartBody.addEventListener("click", function (event) {
                const targetBtn = event.target.closest("[data-action]");
                if (!targetBtn) return;

                const action = targetBtn.dataset.action;
                const kitchen = decodeURIComponent(targetBtn.dataset.kitchen || "");
                const index = Number(targetBtn.dataset.index);
                const cart = getCart();

                if (!cart[kitchen] || !Array.isArray(cart[kitchen])) return;

                if (action === "plus") {
                    const currentQty = Number(cart[kitchen][index]?.qty) || 1;
                    cart[kitchen][index].qty = Math.min(currentQty + 1, 100);
                    cart[kitchen][index].quantity = cart[kitchen][index].qty;
                    saveCart(cart);
                    refreshCartLayoutView();
                } else if (action === "minus") {
                    const currentQty = Number(cart[kitchen][index]?.qty) || 1;
                    if (currentQty > 1) {
                        cart[kitchen][index].qty = currentQty - 1;
                        cart[kitchen][index].quantity = cart[kitchen][index].qty;
                    } else {
                        cart[kitchen].splice(index, 1);
                        if (cart[kitchen].length === 0) delete cart[kitchen];
                    }
                    saveCart(cart);
                    refreshCartLayoutView();
                } else if (action === "delete") {
                    cart[kitchen].splice(index, 1);
                    if (cart[kitchen].length === 0) delete cart[kitchen];
                    saveCart(cart);
                    refreshCartLayoutView();
                } else if (action === "clear-kitchen") {
                    if (confirm(`Remove all items from ${kitchen}?`)) {
                        delete cart[kitchen];
                        saveCart(cart);
                        refreshCartLayoutView();
                    }
                } else if (action === "checkout-kitchen") {
                    const kitchenId = targetBtn.dataset.kitchenId || cart[kitchen][0]?.kitchenId || "";
                    localStorage.setItem("selectedCheckoutKitchen", kitchen);
                    sessionStorage.setItem("selectedCheckoutKitchen", kitchen);
                    window.location.href = `/Customer/Checkout?kitchen=${encodeURIComponent(kitchen)}&kitchenId=${encodeURIComponent(kitchenId)}`;
                }
            });


            /* =========================
               ADD ITEM FROM KITCHEN MENU
            ========================== */

            window.addKitchenItemToCart =
                function (
                    kitchenName,
                    kitchenId,
                    itemId,
                    itemName,
                    itemPrice,
                    itemImage
                ) {

                    const cart =
                        getCart();


                    const parsedKitchenId =
                        Number(
                            kitchenId
                        );

                    const parsedItemId =
                        Number(
                            itemId
                        );


                    const price =
                        Number(
                            itemPrice
                        ) || 0;


                    /* -------------------------
                       VALIDATION
                    -------------------------- */

                    if (
                        !kitchenName ||
                        parsedKitchenId <= 0 ||
                        parsedItemId <= 0
                    ) {

                        console.error(
                            "Invalid kitchen or menu item information."
                        );

                        alert(
                            "Unable to add this item to cart."
                        );

                        return;

                    }


                    /* -------------------------
                       CREATE KITCHEN CART
                    -------------------------- */

                    if (
                        !cart[kitchenName]
                    ) {

                        cart[kitchenName] = [];

                    }


                    /* -------------------------
                       FIND EXISTING ITEM
                    -------------------------- */

                    const existing =
                        cart[kitchenName].find(
                            function (item) {

                                return Number(
                                    item.menuItemId
                                ) ===
                                parsedItemId;

                            }
                        );


                    /* -------------------------
                       INCREASE QUANTITY
                    -------------------------- */

                    if (existing) {

                        existing.qty =
                            Math.min(
                                (
                                    Number(
                                        existing.qty
                                    ) || 1
                                ) + 1,
                                100
                            );

                        existing.kitchenId =
                            parsedKitchenId;

                    }

                    /* -------------------------
                       ADD NEW ITEM
                    -------------------------- */

                    else {

                        cart[kitchenName].push({

                            kitchenId:
                                parsedKitchenId,

                            menuItemId:
                                parsedItemId,

                            /*
                             * UI display values only.
                             * Server recalculates the
                             * actual price from DB.
                             */

                            name:
                                String(
                                    itemName || ""
                                ),

                            price:
                                price,

                            img:
                                String(
                                    itemImage || ""
                                ),

                            kitchen:
                                String(
                                    kitchenName
                                ),

                            qty:
                                1

                        });

                    }


                    saveCart(cart);

                    refreshCartLayoutView();

                    openCart();

                };


            /* =========================
               ESCAPE HTML
            ========================== */

            function escapeHtml(value) {

                return String(
                    value ?? ""
                )
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                );

            }


