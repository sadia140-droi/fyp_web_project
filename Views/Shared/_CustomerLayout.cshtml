@using CloudKitchen.Data
@inject CloudKitchenDbContext DbContext
@{
    var userEmail = User.Identity?.Name;
    string profilePicUrl = null;
    string customerInitial = "U";
    string userLang = Context.Request.Cookies["app_language"] ?? "English";
    if (!string.IsNullOrEmpty(userEmail))
    {
        var customer = DbContext.Customers.FirstOrDefault(c => c.Email == userEmail);
        profilePicUrl = customer?.ProfilePictureUrl;
        if (customer != null)
        {
            if (!string.IsNullOrWhiteSpace(customer.Name))
            {
                var cTrim = customer.Name.Trim();
                var cSplit = cTrim.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                customerInitial = cSplit.Length > 1 
                    ? $"{cSplit[0][0]}{cSplit[cSplit.Length - 1][0]}".ToUpper() 
                    : (cSplit.Length > 0 && cSplit[0].Length > 0 ? cSplit[0].Substring(0, 1).ToUpper() : "U");
            }
            var cSettings = DbContext.CustomerSettings.FirstOrDefault(s => s.CustomerId == customer.Id);
            if (cSettings != null && !string.IsNullOrEmpty(cSettings.Language))
            {
                userLang = cSettings.Language;
            }
        }
    }
}
<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script>
        window.currentUserEmail = '@(User.Identity?.Name ?? "guest")';
    </script>

    <title>@ViewData["Title"] - Cloud Kitchen</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap"
          rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Multi-Language Google Translate Style Cleanup -->
    <style>
        .goog-te-banner-frame.skiptranslate,
        .goog-te-banner-frame {
            display: none !important;
        }
        body {
            top: 0px !important;
        }
        .goog-tooltip, .goog-tooltip:hover {
            display: none !important;
        }
        .goog-text-highlight {
            background-color: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }
        #goog-gt-tt, .goog-te-balloon-frame {
            display: none !important;
        }
        .skiptranslate:not(.goog-te-gadget) {
            display: none !important;
        }
        #google_translate_element {
            display: none !important;
        }
    </style>

    <style>

        :root {
            --soft-orange: #FFB347;
            --beige: #F5E6CA;
            --light-beige: #F8EEDC;
            --dark-brown: #5D4037;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: #f7f7f7;
            overflow-x: hidden;
        }

        /* =========================
                       TOPBAR
                ========================== */

        .customer-topbar {
            width: 100%;
            height: 75px;
            background: var(--soft-orange);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            position: sticky;
            top: 0;
            z-index: 5000;
            box-shadow: 0 5px 20px rgba(0,0,0,0.12);
        }

        .customer-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .customer-logo {
            height: 50px;
            width: 50px;
            object-fit: contain;
            background: transparent !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
            border-radius: 0 !important;
        }

        .customer-brand-name {
            color: var(--dark-brown);
            font-size: 22px;
            font-weight: 800;
        }

        .customer-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .customer-action {
            width: 45px;
            height: 45px;
            border: none;
            background: transparent;
            color: var(--dark-brown);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            position: relative;
            font-size: 19px;
        }

            .customer-action:hover {
                background: rgba(255,255,255,0.35);
            }

        .customer-badge {
            position: absolute;
            top: 0;
            right: 0;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            background: red;
            color: white;
            border-radius: 50%;
            font-size: 10px;
            font-weight: 700;
            display: none;
            align-items: center;
            justify-content: center;
        }

        /* =========================
                       OVERLAY
                ========================== */

        .customer-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 6000;
            opacity: 0;
            visibility: hidden;
            transition: 0.3s ease;
        }

            .customer-overlay.active {
                opacity: 1;
                visibility: visible;
            }

        /* =========================
                       DRAWER
                ========================== */

        .customer-drawer {
            position: fixed;
            top: 0;
            right: -450px;
            width: 420px;
            max-width: 100%;
            height: 100vh;
            background: white;
            z-index: 7000;
            display: flex;
            flex-direction: column;
            transition: right 0.35s ease;
            box-shadow: -10px 0 35px rgba(0,0,0,0.2);
        }

            .customer-drawer.active {
                right: 0;
            }

        .customer-drawer-header {
            height: 75px;
            padding: 0 20px;
            background: white;
            border-bottom: 1px solid #eee;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .customer-drawer-title {
            margin: 0;
            color: var(--dark-brown);
            font-size: 20px;
            font-weight: 800;
        }

        .customer-close {
            width: 38px;
            height: 38px;
            border: none;
            background: #f5f5f5;
            border-radius: 50%;
            font-size: 22px;
            cursor: pointer;
            color: var(--dark-brown);
        }

            .customer-close:hover {
                background: var(--beige);
            }

        .customer-drawer-body {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
        }

        /* =========================
               CART DRAWER STYLES
        ========================== */

        .cart-disclaimer {
            padding: 10px 20px 14px;
            font-size: 0.85rem;
            color: #777;
            margin: 0;
            line-height: 1.4;
            border-bottom: 1px solid #f4ede6;
        }

        .cart-kitchen-card {
            background: #fffcf8;
            border: 1px solid #fae8d8;
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 18px;
            box-shadow: 0 4px 15px rgba(61, 35, 20, 0.03);
        }

        .cart-kitchen-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 14px;
        }

        .cart-kitchen-title-box {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #3e2723;
            font-weight: 800;
            font-size: 1rem;
        }

        .cart-kitchen-title-box i {
            color: #f5a623;
            font-size: 0.95rem;
        }

        .cart-kitchen-count {
            font-size: 0.82rem;
            color: #888;
            margin-top: 2px;
        }

        .btn-clear-kitchen {
            background: none;
            border: none;
            color: #e53935;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            padding: 0;
            transition: color 0.2s;
        }

        .btn-clear-kitchen:hover {
            color: #b71c1c;
            text-decoration: underline;
        }

        .cart-item-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .cart-item-thumbnail {
            width: 52px;
            height: 52px;
            border-radius: 8px;
            object-fit: cover;
            flex-shrink: 0;
            background: #f5f5f5;
        }

        .cart-item-info {
            flex: 1;
            min-width: 0;
        }

        .cart-item-title {
            font-weight: 700;
            font-size: 0.92rem;
            color: #222;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0;
        }

        .cart-item-price-tag {
            color: #c85a17;
            font-weight: 700;
            font-size: 0.85rem;
            margin-top: 2px;
        }

        .cart-item-stepper {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 6px;
            background: #f8f8f8;
            border: 1px solid #eee;
            border-radius: 6px;
            padding: 2px 6px;
        }

        .cart-qty-btn {
            background: none;
            border: none;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            color: #555;
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

        .cart-qty-btn:hover {
            color: #000;
        }

        .cart-qty-val {
            font-weight: 700;
            font-size: 0.85rem;
            min-width: 14px;
            text-align: center;
            color: #333;
        }

        .cart-item-trash {
            background: none;
            border: none;
            color: #bbb;
            cursor: pointer;
            font-size: 16px;
            padding: 6px;
            transition: color 0.2s;
        }

        .cart-item-trash:hover {
            color: #e53935;
        }

        .cart-pricing-box {
            border-top: 1px dashed #e8ded4;
            padding-top: 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 0.88rem;
            color: #666;
        }

        .cart-pricing-row {
            display: flex;
            justify-content: space-between;
        }

        .cart-pricing-row.total-row {
            font-weight: 800;
            font-size: 1rem;
            color: #222;
            margin-top: 4px;
        }

        .btn-kitchen-checkout {
            width: 100%;
            background: #3e2723;
            color: #ffffff;
            border-radius: 8px;
            padding: 12px 16px;
            font-weight: 700;
            font-size: 0.94rem;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 14px;
            transition: background 0.2s;
        }

        .btn-kitchen-checkout:hover {
            background: #2b1b18;
            color: #ffffff;
        }

        .empty-cart {
            text-align: center;
            color: #999;
            padding: 60px 10px;
        }

            .empty-cart i {
                font-size: 45px;
                color: #ddd;
                margin-bottom: 15px;
            }

        /* =========================
                       MENU DRAWER
                ========================== */

        .customer-menu-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .customer-menu-list li {
                margin-bottom: 8px;
            }

            .customer-menu-list a {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 13px;
                color: var(--dark-brown);
                text-decoration: none;
                border-radius: 10px;
                font-weight: 600;
            }

                .customer-menu-list a:hover {
                    background: var(--light-beige);
                }

        /* =========================
                       NOTIFICATION DRAWER
                ========================== */

        .customer-notification-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px;
            margin-bottom: 10px;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 14px;
            transition: 0.2s ease;
        }

            .customer-notification-item:hover {
                background: var(--light-beige);
                border-color: var(--soft-orange);
            }

            .customer-notification-item.order-status {
                cursor: pointer;
            }

            .customer-notification-item.unread {
                background: #fffaf1;
                border-left: 4px solid var(--soft-orange);
            }

        .notification-icon-box {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 12px;
            background: var(--light-beige);
            color: var(--dark-brown);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .notification-content {
            flex: 1;
        }

        .notification-title {
            margin: 0;
            color: var(--dark-brown);
            font-size: 14px;
            font-weight: 800;
        }

        .notification-message {
            margin: 3px 0;
            color: #666;
            font-size: 12px;
            line-height: 1.4;
        }

        .notification-time {
            color: #aaa;
            font-size: 10px;
        }

        .notification-arrow {
            color: #aaa;
            font-size: 13px;
        }

        .normal-notification {
            cursor: pointer;
        }

        .notification-actions {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 12px;
        }

        .mark-all-btn {
            border: none;
            background: transparent;
            color: var(--dark-brown);
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

            .mark-all-btn:hover {
                text-decoration: underline;
            }

        /* =========================
                       MOBILE
                ========================== */

        @@media (max-width: 600px) {

            .customer-brand-name {
                font-size: 17px;
            }

            .customer-logo {
                width: 50px;
                height: 50px;
                background: transparent !important;
            }

            .customer-topbar {
                padding: 0 10px;
            }

            .customer-drawer {
                width: 100%;
            }
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- =========================
         OVERLAY
    ========================== -->

    <div id="customerOverlay"
         class="customer-overlay"></div>


    <!-- =========================
         TOPBAR
    ========================== -->

    <header class="customer-topbar">
        <div class="container d-flex justify-content-between align-items-center w-100">
        <a asp-controller="Customer"
           asp-action="Index"
           class="customer-brand">

            <img src="/images/logo.png"
                 class="customer-logo"
                 alt="Cloud Kitchen">

            <span class="customer-brand-name">
                Cloud Kitchen
            </span>

        </a>


        <div class="customer-actions">

            <!-- Notification -->

            <button type="button"
                    id="customerNotificationBtn"
                    class="customer-action">

                <i class="fas fa-bell"></i>

                <span id="customerNotificationBadge"
                      class="customer-badge">
                    0
                </span>

            </button>


            <!-- Cart -->

            <button type="button"
                    id="customerCartBtn"
                    class="customer-action">

                <i class="fas fa-shopping-cart"></i>

                <span id="customerCartBadge"
                      class="customer-badge">
                    0
                </span>

            </button>


            <!-- Menu -->

            <button type="button"
                    id="customerMenuBtn"
                    class="customer-action">

                <i class="fas fa-bars"></i>

            </button>

        </div>
        </div>
    </header>


    <!-- =========================
         MENU DRAWER
    ========================== -->

    <aside id="customerMenuDrawer"
           class="customer-drawer">

        <div class="customer-drawer-header">

            <h3 class="customer-drawer-title">
                Menu
            </h3>

            <button type="button"
                    id="customerMenuClose"
                    class="customer-close">
                ×
            </button>

        </div>


        <div class="customer-drawer-body">

            <ul class="customer-menu-list">

                <li>
                    <a asp-controller="Home"
                       asp-action="Index">

                        <i class="fas fa-home"></i>
                        Home

                    </a>
                </li>

                <li>
                    <a asp-controller="Customer"
                       asp-action="OrderHistory">

                        <i class="fas fa-history"></i>
                        Order History

                    </a>
                </li>

                <li>
                    <a asp-controller="Customer"
                       asp-action="Favorite">

                        <i class="fas fa-heart"></i>
                        Favorite Kitchens

                    </a>
                </li>

                <li>
                    <a asp-controller="Customer"
                       asp-action="Settings">

                        <i class="fas fa-cog"></i>
                        Settings

                    </a>
                </li>

                <li>
                    <a asp-controller="Customer"
                       asp-action="Profile">

                        @if (!string.IsNullOrEmpty(profilePicUrl) && !profilePicUrl.Contains("profile.png"))
                        {
                            <img src="@Url.Content("~/" + profilePicUrl.TrimStart('/'))" style="width:24px; height:24px; border-radius:50%; object-fit:cover; margin-right:6px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" alt="" />
                            <span class="avatar-letter-circle avatar-letter-sm" style="display:none; margin-right:6px;">@customerInitial</span>
                        }
                        else
                        {
                            <span class="avatar-letter-circle avatar-letter-sm" style="margin-right:6px;">@customerInitial</span>
                        }
                        Profile

                    </a>
                </li>

                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" id="customerLogoutForm" style="display: none;">
                        @Html.AntiForgeryToken()
                    </form>
                    <a href="javascript:void(0);" onclick="handleCustomerLogout();">
                        <i class="fas fa-sign-out-alt"></i>
                        Logout
                    </a>
                </li>

            </ul>

        </div>

    </aside>


    <!-- =========================
         NOTIFICATION DRAWER
    ========================== -->

    <aside id="customerNotificationDrawer"
           class="customer-drawer">

        <div class="customer-drawer-header">

            <h3 class="customer-drawer-title">
                <i class="fas fa-bell"></i>
                Notifications
            </h3>

            <button type="button"
                    id="customerNotificationClose"
                    class="customer-close">
                ×
            </button>

        </div>


        <div id="customerNotificationBody"
             class="customer-drawer-body">

            <div class="empty-cart">

                <i class="fas fa-bell"></i>

                <p>Loading notifications...</p>

            </div>

        </div>

    </aside>


    <!-- =========================
         CART DRAWER
    ========================== -->

    <aside id="customerCartDrawer"
           class="customer-drawer">

        <div class="customer-drawer-header">

            <h3 class="customer-drawer-title">
                Your Cart
            </h3>

            <button type="button"
                    id="customerCartClose"
                    class="customer-close">
                ×
            </button>

        </div>

        <p class="cart-disclaimer" id="customerCartDisclaimer" style="display: none; padding: 0 24px 8px; font-size: 0.82rem; color: #777; margin: 0; line-height: 1.4;">
            Each kitchen delivers separately — check out one kitchen at a time.
        </p>

        <div id="customerCartBody"
             class="customer-drawer-body">
        </div>

        <div class="cart-footer" id="customerCartFooter" style="display: none;">

            <div class="cart-total">

                <span>Total</span>

                <span id="customerCartTotal">
                    Rs. 0
                </span>

            </div>

            <button type="button"
                    id="customerCheckoutBtn"
                    class="checkout-main-btn">

                <i class="fas fa-shopping-bag me-2"></i>

                Proceed to Checkout

            </button>

        </div>

    </aside>


    <!-- =========================
         PAGE CONTENT
    ========================== -->

    <main>

        @RenderBody()

    </main>


    <!-- =========================
         ANTI FORGERY TOKEN
    ========================== -->

    <form id="notificationAntiForgeryForm"
          style="display:none;">

        @Html.AntiForgeryToken()

    </form>


    <!-- =========================
         BOOTSTRAP
    ========================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =========================
         CUSTOMER CART + NOTIFICATION ENGINE
    ========================== -->

    <script>

        (function () {

            "use strict";


            /* =========================
               ELEMENTS
            ========================== */

            const cartBtn =
                document.getElementById(
                    "customerCartBtn"
                );

            const cartDrawer =
                document.getElementById(
                    "customerCartDrawer"
                );

            const cartClose =
                document.getElementById(
                    "customerCartClose"
                );

            const cartBody =
                document.getElementById(
                    "customerCartBody"
                );

            const cartBadge =
                document.getElementById(
                    "customerCartBadge"
                );

            const cartTotal =
                document.getElementById(
                    "customerCartTotal"
                );

            const checkoutBtn =
                document.getElementById(
                    "customerCheckoutBtn"
                );


            const menuBtn =
                document.getElementById(
                    "customerMenuBtn"
                );

            const menuDrawer =
                document.getElementById(
                    "customerMenuDrawer"
                );

            const menuClose =
                document.getElementById(
                    "customerMenuClose"
                );


            const notificationBtn =
                document.getElementById(
                    "customerNotificationBtn"
                );

            const notificationDrawer =
                document.getElementById(
                    "customerNotificationDrawer"
                );

            const notificationClose =
                document.getElementById(
                    "customerNotificationClose"
                );

            const notificationBody =
                document.getElementById(
                    "customerNotificationBody"
                );

            const notificationBadge =
                document.getElementById(
                    "customerNotificationBadge"
                );


            const overlay =
                document.getElementById(
                    "customerOverlay"
                );


            /* =========================
               CART STORAGE (USER-SCOPED)
            ========================== */

            window.getCartStorageKey = function () {
                const email = (window.currentUserEmail && window.currentUserEmail !== "guest")
                    ? window.currentUserEmail.trim().toLowerCase()
                    : "guest";
                return "kitchenCarts_" + encodeURIComponent(email);
            };

            window.handleCustomerLogout = function () {
                try {
                    const key = window.getCartStorageKey();
                    localStorage.removeItem(key);
                    localStorage.removeItem("kitchenCarts");
                    localStorage.removeItem("selectedCheckoutKitchen");
                    sessionStorage.clear();
                } catch (e) {}
                const form = document.getElementById("customerLogoutForm");
                if (form) form.submit();
            };

            function getCart() {
                try {
                    const storageKey = window.getCartStorageKey();
                    if (localStorage.getItem("kitchenCarts")) {
                        localStorage.removeItem("kitchenCarts"); // Clean legacy shared key
                    }

                    const data = localStorage.getItem(storageKey);
                    if (!data) {
                        return {};
                    }

                    const parsed = JSON.parse(data);
                    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
                        return {};
                    }

                    return parsed;
                }
                catch (error) {
                    console.error("Cart read error:", error);
                    return {};
                }
            }

            function saveCart(cart) {
                try {
                    const storageKey = window.getCartStorageKey();
                    localStorage.setItem(storageKey, JSON.stringify(cart));
                    localStorage.removeItem("kitchenCarts"); // Ensure legacy key doesn't linger
                }
                catch (error) {
                    console.error("Cart save error:", error);
                }
            }


            /* =========================
               CLOSE ALL DRAWERS
            ========================== */

            function closeAllDrawers() {

                cartDrawer.classList.remove(
                    "active"
                );

                menuDrawer.classList.remove(
                    "active"
                );

                notificationDrawer.classList.remove(
                    "active"
                );

                overlay.classList.remove(
                    "active"
                );

            }


            /* =========================
               OPEN CART
            ========================== */

            function openCart() {

                closeAllDrawers();

                cartDrawer.classList.add(
                    "active"
                );

                overlay.classList.add(
                    "active"
                );

