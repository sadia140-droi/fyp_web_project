            /* =========================
               FALLBACK CHECKOUT BUTTON
            ========================== */

            if (checkoutBtn) {
                checkoutBtn.addEventListener("click", function () {
                    const cart = getCart();
                    const kitchenNames = Object.keys(cart).filter(k => Array.isArray(cart[k]) && cart[k].length > 0);
                    if (kitchenNames.length === 0) {
                        alert("Your cart is empty!");
                        return;
                    }
                    const firstKitchen = kitchenNames[0];
                    const firstKitchenId = cart[firstKitchen][0]?.kitchenId || "";
                    localStorage.setItem("selectedCheckoutKitchen", firstKitchen);
                    sessionStorage.setItem("selectedCheckoutKitchen", firstKitchen);
                    window.location.href = `/Customer/Checkout?kitchen=${encodeURIComponent(firstKitchen)}&kitchenId=${encodeURIComponent(firstKitchenId)}`;
                });
            }


            /* =========================
               INITIALIZE
            ========================== */

            refreshCartLayoutView();

            loadNotificationBadge();


        })();

    </script>


    @await RenderSectionAsync("Scripts", required: false)

    <!-- Multi-Language Translation Loader -->
    <div id="google_translate_element" style="display:none;"></div>
    <script type="text/javascript">
        (function() {
            var savedLang = '@userLang';
            var targetCode = savedLang === 'Urdu' ? '/en/ur' : (savedLang === 'Arabic' ? '/en/ar' : '/en/en');
            var currentCookie = document.cookie.split('; ').find(function(row) { return row.startsWith('googtrans='); });
            var currentVal = currentCookie ? currentCookie.split('=')[1] : '';
            if (currentVal !== targetCode) {
                document.cookie = "googtrans=" + targetCode + "; path=/;";
                document.cookie = "googtrans=" + targetCode + "; path=/; domain=" + window.location.hostname + ";";
            }
        })();

        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,ur,ar',
                autoDisplay: false
            }, 'google_translate_element');
        }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

</body>
</html>