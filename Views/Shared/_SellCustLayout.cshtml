<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Cloud Kitchen</title>
    <link rel="stylesheet" href="~/css/seller_auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer_auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Varification.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        html, body {
            min-height: 100%;
            height: auto;
            margin: 0 !important;
            padding: 0 !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            background-color: var(--page-bg, #F5E6CA) !important;
        }
        body {
            margin-bottom: 0 !important;
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        @RenderBody()
    </div>
    
    <script src="~/js/seller_auth.js" asp-append-version="true"></script>
    <script src="~/js/customer_auth.js" asp-append-version="true"></script>
    <script src="~/js/Kitchen-Information.js" asp-append-version="true"></script>
</body>
</html>
