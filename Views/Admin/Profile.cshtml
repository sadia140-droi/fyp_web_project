@model Cloud_Kitchen_web_App.Models.ApplicationUser

@{
    ViewData["Title"] = "Admin Profile";
    Layout = "~/Views/Shared/Admin.cshtml";
}

<style>
    /* ================= PROFILE HEADER ================= */
    .profile-box {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .profile-box img {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        object-fit: cover;
    }

    .profile-avatar-letter {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #FFB347, #ff9800);
        color: #5D4037;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        font-weight: 800;
        box-shadow: 0 4px 14px rgba(255, 179, 71, 0.4);
        border: 2px solid rgba(255, 255, 255, 0.9);
        user-select: none;
        flex-shrink: 0;
        text-transform: uppercase;
    }

    .profile-info h2 {
        color: var(--dark-brown);
        margin-bottom: 5px;
        font-size: 24px;
        font-weight: 700;
    }

    .profile-info p {
        color: #666;
        font-size: 14px;
    }

    /* ================= FORM ================= */
    .profile-card {
        background: #fff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        max-width: 800px;
    }

    .form-group {
        margin-top: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark-brown);
        font-weight: 600;
        font-size: 14px;
    }

    .form-group input {
        width: 100%;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #ddd;
        font-size: 14px;
        font-family: 'Poppins', sans-serif;
        transition: 0.2s;
    }

    .form-group input:focus {
        outline: none;
        border-color: var(--soft-orange);
        box-shadow: 0 0 0 3px rgba(255,179,71,0.15);
    }

    /* ================= SAVE BUTTON ================= */
    .save-btn {
        margin-top: 25px;
        padding: 12px 24px;
        background: var(--soft-orange);
        color: var(--dark-brown);
        border: none;
        border-radius: 8px;
        font-weight: 700;
        font-family: 'Poppins', sans-serif;
        cursor: pointer;
        transition: 0.2s;
    }

    .save-btn:hover {
        background: #f5a63a;
        transform: translateY(-2px);
    }

    .message {
        margin-top: 15px;
        color: #155724;
        background: #d4edda;
        padding: 10px 15px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 14px;
    }

    .validation {
        color: #dc3545;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }
</style>

<div class="profile-card">

    <!-- ================= PROFILE HEADER ================= -->
    <div class="profile-box">
        @{
            var aName = string.IsNullOrWhiteSpace(Model.FullName) ? "Admin" : Model.FullName.Trim();
            var aParts = aName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var aInitials = aParts.Length > 1 
                ? $"{aParts[0][0]}{aParts[aParts.Length - 1][0]}".ToUpper() 
                : (aParts.Length > 0 && aParts[0].Length > 0 ? aParts[0].Substring(0, 1).ToUpper() : "A");
        }
        <div class="profile-avatar-letter" title="@aName">@aInitials</div>

        <div class="profile-info">
            <h2>
                @Model.FullName
            </h2>
            <p>
                @Model.Email
            </p>
        </div>
    </div>


    <!-- ================= PROFILE FORM ================= -->
    <form asp-controller="Admin"
          asp-action="Profile"
          method="post">

        @Html.AntiForgeryToken()

        <!-- FULL NAME -->
        <div class="form-group">
            <label for="FullName">
                Full Name
            </label>
            <input type="text"
                   id="FullName"
                   name="fullName"
                   value="@Model.FullName"
                   required>
            <span asp-validation-for="FullName"
                  class="validation">
            </span>
        </div>

        <!-- EMAIL -->
        <div class="form-group">
            <label for="Email">
                Email
            </label>
            <input type="email"
                   id="Email"
                   name="email"
                   value="@Model.Email"
                   required>
            <span asp-validation-for="Email"
                  class="validation">
            </span>
        </div>

        <!-- PASSWORD -->
        <div class="form-group">
            <label for="Password">
                Password
            </label>
            <input type="password"
                   id="Password"
                   name="password"
                   value=""
                   placeholder="Enter new password (optional)">
        </div>

        <!-- SAVE BUTTON -->
        <button type="submit" class="save-btn">
            <i class="fa-solid fa-floppy-disk"></i> Save Changes
        </button>

    </form>


    <!-- ================= SUCCESS MESSAGE ================= -->
    @if (ViewBag.Message != null)
    {
        <div class="message">
            @ViewBag.Message
        </div>
    }

</div>
