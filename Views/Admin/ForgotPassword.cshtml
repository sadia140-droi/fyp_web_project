@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Admin - Forgot Password</title>


    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


    <style>

        :root {
            --orange: #FFB347;
            --orange-dark: #f39a21;
            --beige: #F5E6CA;
            --brown: #5D4037;
            --brown-light: #795548;
            --white: #ffffff;
            --gray: #777;
            --light-gray: #f6f6f6;
            --border: #e5e5e5;
        }


        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
        }


        body {
            min-height: 100vh;

            background: var(--beige);

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 30px 20px;
        }


        /* =========================
           MAIN CONTAINER
           ========================= */

        .page-container {
            width: 100%;

            max-width: 1050px;

            min-height: 620px;

            background: var(--white);

            border-radius: 24px;

            overflow: hidden;

            display: grid;

            grid-template-columns: 1fr 1fr;

            box-shadow: 0 20px 60px rgba(93, 64, 55, 0.15);
        }


        /* =========================
           LEFT SECTION
           ========================= */

        .left-section {
            background: var(--brown);

            padding: 55px 50px;

            display: flex;

            flex-direction: column;

            justify-content: center;

            position: relative;

            overflow: hidden;
        }


        .left-section::before {
            content: "";

            position: absolute;

            width: 300px;

            height: 300px;

            border-radius: 50%;

            background: rgba(255, 179, 71, 0.12);

            top: -120px;

            left: -100px;
        }


        .left-section::after {
            content: "";

            position: absolute;

            width: 250px;

            height: 250px;

            border-radius: 50%;

            background: rgba(255, 179, 71, 0.08);

            bottom: -100px;

            right: -80px;
        }


        /* =========================
           BRAND
           ========================= */

        .brand {
            position: relative;

            z-index: 2;

            display: flex;

            align-items: center;

            margin-bottom: 50px;
        }


        .brand img {
            width: 50px;

            height: 50px;

            object-fit: contain;

            margin-right: 14px;

            background: transparent !important;

            padding: 0 !important;

            border: none !important;

            box-shadow: none !important;
        }


        .brand-name {
            color: white;

            font-size: 24px;

            font-weight: 700;
        }


        .brand-name span {
            display: block;

            color: var(--orange);

            font-size: 13px;

            font-weight: 500;

            margin-top: 3px;
        }


        /* =========================
           LEFT CONTENT
           ========================= */

        .left-content {
            position: relative;

            z-index: 2;
        }


        .left-content .icon {
            width: 75px;

            height: 75px;

            background: var(--orange);

            color: var(--brown);

            border-radius: 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 32px;

            margin-bottom: 28px;
        }


        .left-content h1 {
            color: white;

            font-size: 38px;

            line-height: 1.2;

            margin-bottom: 18px;
        }


        .left-content p {
            color: #eadfd9;

            font-size: 15px;

            line-height: 1.8;

            max-width: 400px;
        }


        /* =========================
           SECURITY INFO
           ========================= */

        .security-info {
            position: relative;

            z-index: 2;

            display: flex;

            align-items: center;

            gap: 12px;

            margin-top: 45px;

            color: #eadfd9;

            font-size: 13px;
        }


        .security-info i {
            color: var(--orange);

            font-size: 18px;
        }


        /* =========================
           RIGHT SECTION
           ========================= */

        .right-section {
            padding: 55px 60px;

            display: flex;

            align-items: center;

            justify-content: center;
        }


        .form-container {
            width: 100%;

            max-width: 410px;
        }


        .form-container h2 {
            color: var(--brown);

            font-size: 29px;

            margin-bottom: 10px;
        }


        .subtitle {
            color: var(--gray);

            font-size: 14px;

            line-height: 1.7;

            margin-bottom: 32px;
        }


        /* =========================
           FORM
           ========================= */

        .form-group {
            margin-bottom: 22px;
        }


        .form-group label {
            display: block;

            color: var(--brown);

            font-size: 14px;

            font-weight: 600;

            margin-bottom: 9px;
        }


        .input-wrapper {
            position: relative;
        }


        .input-wrapper > i {
            position: absolute;

            left: 16px;

            top: 50%;

            transform: translateY(-50%);

            color: #aaa;

            font-size: 16px;

            transition: 0.3s;
        }


        .input-wrapper input {
            width: 100%;

            height: 52px;

            border: 1px solid var(--border);

            border-radius: 10px;

            padding: 0 16px 0 45px;

            outline: none;

            color: var(--brown);

            font-size: 14px;

            background: #fff;

            transition: all 0.3s;
        }


        .input-wrapper input::placeholder {
            color: #aaa;
        }


        .input-wrapper input:focus {
            border-color: var(--orange);

            box-shadow: 0 0 0 4px rgba(255, 179, 71, 0.12);
        }


        /* =========================
           BUTTON
           ========================= */

        .reset-button {
            width: 100%;

            height: 52px;

            border: none;

            border-radius: 10px;

            background: var(--orange);

            color: var(--brown);

            font-size: 15px;

            font-weight: 700;

            cursor: pointer;

            transition: all 0.3s;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 9px;
        }


        .reset-button:hover {
            background: var(--orange-dark);

            transform: translateY(-1px);

            box-shadow: 0 8px 20px rgba(255, 179, 71, 0.3);
        }


        .reset-button:active {
            transform: translateY(0);
        }


        .reset-button:disabled {
            opacity: 0.7;

            cursor: not-allowed;
        }


        /* =========================
           MESSAGE
           ========================= */

        .message {
            margin-top: 18px;

            padding: 13px 15px;

            border-radius: 9px;

            font-size: 13px;

            line-height: 1.5;
        }


        .message.success {
            background: #e9f7ef;

            color: #26734d;

            border: 1px solid #c9ead8;
        }


        .message.error {
            background: #fff0f0;

            color: #a94442;

            border: 1px solid #f1cccc;
        }


        /* =========================
           VALIDATION
           ========================= */

        .validation-message {
            display: block;

            color: #a94442;

            font-size: 12px;

            margin-top: 5px;
        }


        /* =========================
           BACK LOGIN
           ========================= */

        .back-login {
            text-align: center;

            margin-top: 28px;
        }


        .back-login a {
            color: var(--brown);

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;

            transition: 0.3s;
        }


        .back-login a:hover {
            color: var(--orange-dark);
        }


        .back-login i {
            margin-right: 7px;
        }


        /* =========================
           FOOTER
           ========================= */

        .footer-text {
            text-align: center;

            color: #aaa;

            font-size: 12px;

            margin-top: 35px;
        }


        /* =========================
           LOADING
           ========================= */

        .spinner {
            display: none;

            width: 17px;

            height: 17px;

            border: 2px solid rgba(93, 64, 55, 0.3);

            border-top-color: var(--brown);

            border-radius: 50%;

            animation: spin 0.7s linear infinite;
        }


        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }


        /* =========================
           TABLET
           ========================= */

        @@media (max-width: 850px) {

            .page-container {
                grid-template-columns: 1fr;

                max-width: 500px;
            }


            .left-section {
                padding: 40px;

                min-height: 330px;
            }


            .brand {
                margin-bottom: 30px;
            }


            .left-content .icon {
                width: 60px;

                height: 60px;

                font-size: 25px;

                margin-bottom: 18px;
            }


            .left-content h1 {
                font-size: 30px;
            }


            .security-info {
                margin-top: 25px;
            }


            .right-section {
                padding: 45px 40px;
            }
        }


        /* =========================
           MOBILE
           ========================= */

        @@media (max-width: 500px) {

            body {
                padding: 15px;
            }


            .page-container {
                border-radius: 18px;
            }


            .left-section {
                padding: 30px 25px;

                min-height: auto;
            }


            .brand {
                margin-bottom: 30px;
            }


            .brand img {
                width: 50px;

                height: 50px;

                background: transparent !important;
            }


            .brand-name {
                font-size: 19px;
            }


            .left-content h1 {
                font-size: 27px;
            }


            .left-content p {
                font-size: 13px;
            }


            .security-info {
                font-size: 12px;
            }


            .right-section {
                padding: 35px 25px;
            }


            .form-container h2 {
                font-size: 25px;
            }
        }

    </style>

</head>


<body>


    <div class="page-container">


        <!-- =========================
             LEFT SECTION
             ========================= -->

        <div class="left-section">


            <!-- BRAND -->

            <div class="brand">

                <img src="~/Images/logo.png"
                     alt="Cloud Kitchen Logo">


                <div class="brand-name">

                    Cloud Kitchen

                    <span>
                        Admin Portal
                    </span>

                </div>

            </div>


            <!-- LEFT CONTENT -->

            <div class="left-content">


                <div class="icon">

                    <i class="fa-solid fa-key"></i>

                </div>


                <h1>

                    Reset your<br>
                    password

                </h1>


                <p>

                    Don't worry, it happens. Enter your registered
                    admin email address and we'll help you get back
                    into your account securely.

                </p>


            </div>


            <!-- SECURITY -->

            <div class="security-info">

                <i class="fa-solid fa-shield-halved"></i>

                <span>
                    Your account security is our priority.
                </span>

            </div>


        </div>


        <!-- =========================
             RIGHT SECTION
             ========================= -->

        <div class="right-section">


            <div class="form-container">


                <h2>
                    Forgot Password?
                </h2>


                <p class="subtitle">

                    Enter the email address associated with your
                    admin account. We'll send you a secure link
                    to create a new password.

                </p>


                <!-- =========================
                     MVC FORM
                     ========================= -->

                <form asp-controller="Admin"
                      asp-action="ForgotPassword"
                      method="post"
                      id="forgotForm">


                    <div class="form-group">


                        <label for="email">
                            Email Address
                        </label>


                        <div class="input-wrapper">


                            <input type="email"
                                   id="email"
                                   name="email"
                                   placeholder="admin@example.com"
                                   required>


                            <i class="fa-solid fa-envelope"></i>


                        </div>


                        <span class="validation-message"
                              id="emailError">
                        </span>


                    </div>


                    <!-- BUTTON -->

                    <button type="submit"
                            class="reset-button"
                            id="resetButton">


                        <span id="buttonText">
                            Send Reset Link
                        </span>


                        <i class="fa-solid fa-paper-plane"
                           id="buttonIcon">
                        </i>


                        <span class="spinner"
                              id="spinner">
                        </span>


                    </button>


                </form>


                <!-- =========================
                     SUCCESS MESSAGE
                     ========================= -->

                @if (ViewBag.Success != null)
                {
                        <div class="message success">

                            <i class="fa-solid fa-circle-check"></i>

                        @ViewBag.Success

                        </div>
                }


                <!-- =========================
                     ERROR MESSAGE
                     ========================= -->

                @if (ViewBag.Error != null)
                {
                        <div class="message error">

                            <i class="fa-solid fa-circle-exclamation"></i>

                        @ViewBag.Error

                        </div>
                }


                <!-- =========================
                     BACK TO LOGIN
                     ========================= -->

                <div class="back-login">

                    <a asp-controller="Admin"
                       asp-action="Login">

                        <i class="fa-solid fa-arrow-left"></i>

                        Back to Admin Login

                    </a>

                </div>


                <!-- FOOTER -->

                <div class="footer-text">

                    © 2026 Cloud Kitchen. All rights reserved.

                </div>


            </div>

        </div>

    </div>


    <!-- =========================
         JAVASCRIPT
         ========================= -->

    <script>

        const form = document.getElementById("forgotForm");

        const email = document.getElementById("email");

        const button = document.getElementById("resetButton");

        const buttonText = document.getElementById("buttonText");

        const buttonIcon = document.getElementById("buttonIcon");

        const spinner = document.getElementById("spinner");


        form.addEventListener("submit", function (e) {

            const emailValue = email.value.trim();


            /* EMAIL VALIDATION */

            const emailPattern =
                /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;


            if (!emailPattern.test(emailValue)) {

                e.preventDefault();

                return;

            }


            /* LOADING */

            button.disabled = true;

            buttonText.textContent = "Sending...";

            buttonIcon.style.display = "none";

            spinner.style.display = "inline-block";

        });

    </script>


</body>

</html>
