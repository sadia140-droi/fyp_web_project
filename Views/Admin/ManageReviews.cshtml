@model List<Cloud_Kitchen_web_App.Models.AdminReviewViewModel>

@{
    ViewData["Title"] = "Customer Reviews";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var totalReviews = Model?.Count ?? 0;
    var avgRating = totalReviews > 0 ? Math.Round(Model!.Average(r => r.Rating), 1) : 0.0;
    var fiveStarCount = Model?.Count(r => r.Rating == 5) ?? 0;
    var lowRatingCount = Model?.Count(r => r.Rating <= 2) ?? 0;

    var uniqueKitchens = Model?
        .Select(r => r.KitchenName)
        .Where(k => !string.IsNullOrWhiteSpace(k) && k != "N/A")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(k => k)
        .ToList() ?? new List<string>();
}

<style>
    .reviews-page {
        width: 100%;
    }

    .heading {
        margin-bottom: 25px;
    }

        .heading h1 {
            color: #5D4037;
            font-size: 30px;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .heading p {
            color: #666;
            margin: 0;
        }

    .summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .card {
        background: #fff;
        padding: 22px 20px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .07);
        border: 1px solid #f2ede7;
    }

        .card h4 {
            color: #777;
            font-size: 14px;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .card h2 {
            color: #5D4037;
            font-size: 28px;
            margin: 0;
            font-weight: 700;
        }

    .controls {
        display: flex;
        gap: 14px;
        margin-bottom: 25px;
        flex-wrap: wrap;
        align-items: center;
    }

        .controls input,
        .controls select {
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid #ddd;
            background: #fff;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .controls input:focus,
        .controls select:focus {
            border-color: #FFB347;
            box-shadow: 0 0 0 3px rgba(255, 179, 71, 0.2);
        }

        .controls input {
            min-width: 280px;
            flex-grow: 1;
        }

    .table-container {
        background: #fff;
        padding: 24px;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .07);
        border: 1px solid #f2ede7;
        overflow-x: auto;
    }

    .reviews-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

        .reviews-table th {
            background: #FFB347;
            color: #5D4037;
            padding: 14px 12px;
            text-align: left;
            white-space: nowrap;
            font-weight: 600;
            font-size: 14px;
        }

        .reviews-table td {
            padding: 15px 12px;
            text-align: left;
            border-bottom: 1px solid #f0ece6;
            font-size: 14px;
            vertical-align: middle;
        }

        .reviews-table tbody tr:hover {
            background: #fffdf8;
        }

    .order-id {
        font-weight: 600;
        color: #5D4037;
        background: #fff4e5;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 12px;
    }

    .stars-badge {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        color: #FFD700;
        font-size: 13px;
    }

    .comment-truncate {
        max-width: 320px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #4a3f35;
        font-style: italic;
        cursor: pointer;
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #666;
    }

        .empty-state i {
            font-size: 46px;
            color: #FFB347;
            margin-bottom: 15px;
        }

        .empty-state h3 {
            color: #5D4037;
            margin-bottom: 8px;
            font-weight: 700;
        }

    @@media (max-width: 1000px) {
        .summary {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .summary {
            grid-template-columns: 1fr;
        }
        .controls input {
            width: 100%;
            min-width: unset;
        }
    }
</style>

<div class="reviews-page">
    <!-- PAGE HEADING -->
    <div class="heading">
        <h1>Manage Customer Reviews</h1>
        <p>Platform-wide customer feedback and kitchen ratings.</p>
    </div>

    <!-- 4 SUMMARY CARDS -->
    <div class="summary">
        <div class="card">
            <h4>Total Reviews</h4>
            <h2>@totalReviews</h2>
        </div>
        <div class="card">
            <h4>Average Rating</h4>
            <h2>
                @avgRating
                <span style="font-size: 20px; color: #FFD700;">★</span>
            </h2>
        </div>
        <div class="card">
            <h4>5-Star Reviews</h4>
            <h2>@fiveStarCount</h2>
        </div>
        <div class="card">
            <h4>Low Ratings (1-2★)</h4>
            <h2>@lowRatingCount</h2>
        </div>
    </div>

    <!-- FILTERS: SEARCH, KITCHEN, RATING -->
    <div class="controls">
        <input type="text"
               id="reviewSearchInput"
               placeholder="Search by order #, kitchen, customer, comment..." />

        <select id="kitchenFilterSelect">
            <option value="all">All Kitchens</option>
            @foreach (var k in uniqueKitchens)
            {
                <option value="@k.ToLower()">@k</option>
            }
        </select>

        <select id="ratingFilterSelect">
            <option value="all">All Ratings</option>
            <option value="5">5 Stars</option>
            <option value="4">4 Stars</option>
            <option value="3">3 Stars</option>
            <option value="2">2 Stars</option>
            <option value="1">1 Star</option>
        </select>
    </div>

    <!-- TABLE CONTAINER -->
    <div class="table-container">
        @if (Model != null && Model.Any())
        {
            <table class="reviews-table" id="adminReviewsTable">
                <thead>
                    <tr>
                        <th style="width: 100px;">Order #</th>
                        <th style="width: 200px;">Kitchen</th>
                        <th style="width: 200px;">Customer</th>
                        <th style="width: 130px;">Rating</th>
                        <th>Comment</th>
                        <th style="width: 160px;">Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Model)
                    {
                        var fullComment = review.Comment ?? string.Empty;
                        <tr data-order="@review.OrderId.ToLower()"
                            data-kitchen="@review.KitchenName.ToLower()"
                            data-customer="@review.CustomerName.ToLower() @review.CustomerEmail.ToLower()"
                            data-comment="@fullComment.ToLower()"
                            data-rating="@review.Rating">
                            <td>
                                <span class="order-id">#@review.OrderId</span>
                            </td>
                            <td>
                                <strong style="color: #5D4037;">@review.KitchenName</strong>
                            </td>
                            <td>
                                <div style="font-weight: 600; color: #333;">@review.CustomerName</div>
                                @if (!string.IsNullOrWhiteSpace(review.CustomerEmail))
                                {
                                    <div class="small text-muted" style="font-size: 12px;">@review.CustomerEmail</div>
                                }
                            </td>
                            <td>
                                <div class="stars-badge">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star" style="opacity: 0.35;"></i>
                                        }
                                    }
                                    <span style="color: #5D4037; font-size: 12px; margin-left: 4px; font-weight:700;">@review.Rating/5</span>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(fullComment))
                                {
                                    <div class="comment-truncate" title="@fullComment">
                                        "@fullComment"
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 13px; font-style: italic;">No comment written</span>
                                }
                            </td>
                            <td style="color: #666; font-size: 13px;">
                                @review.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="noMatchMessage" style="display:none; text-align:center; padding:30px 10px; color:#777;">
                No reviews match your filters.
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fa-regular fa-comment-dots"></i>
                <h3>No reviews yet</h3>
                <p>No customer reviews have been recorded on the platform.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('reviewSearchInput');
            const kitchenSelect = document.getElementById('kitchenFilterSelect');
            const ratingSelect = document.getElementById('ratingFilterSelect');
            const table = document.getElementById('adminReviewsTable');
            const noMatchMsg = document.getElementById('noMatchMessage');

            if (!table) return;

            const rows = table.querySelectorAll('tbody tr');

            function applyFilters() {
                const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
                const selectedKitchen = kitchenSelect ? kitchenSelect.value : 'all';
                const selectedRating = ratingSelect ? ratingSelect.value : 'all';

                let visibleCount = 0;

                rows.forEach(function (row) {
                    const order = row.getAttribute('data-order') || '';
                    const kitchen = row.getAttribute('data-kitchen') || '';
                    const customer = row.getAttribute('data-customer') || '';
                    const comment = row.getAttribute('data-comment') || '';
                    const rating = row.getAttribute('data-rating') || '';

                    const matchesQuery = !query ||
                        order.includes(query) ||
                        kitchen.includes(query) ||
                        customer.includes(query) ||
                        comment.includes(query);

                    const matchesKitchen = selectedKitchen === 'all' || kitchen === selectedKitchen;
                    const matchesRating = selectedRating === 'all' || rating === selectedRating;

                    if (matchesQuery && matchesKitchen && matchesRating) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noMatchMsg) {
                    noMatchMsg.style.display = (visibleCount === 0 && rows.length > 0) ? 'block' : 'none';
                }
            }

            if (searchInput) searchInput.addEventListener('input', applyFilters);
            if (kitchenSelect) kitchenSelect.addEventListener('change', applyFilters);
            if (ratingSelect) ratingSelect.addEventListener('change', applyFilters);
        });
    </script>
}
