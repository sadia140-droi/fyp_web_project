@model List<Cloud_Kitchen_web_App.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var totalOrders = Model?.Count ?? 0;

    var pendingOrders = Model?.Count(x =>
        x.Status == "Order Placed" ||
        x.Status == "Accepted") ?? 0;

    var preparingOrders = Model?.Count(x =>
        x.Status == "Preparing" ||
        x.Status == "Out for Delivery") ?? 0;

    var deliveredOrders = Model?.Count(x =>
        x.Status == "Delivered") ?? 0;
}

<style>

    .orders-page {
        width: 100%;
    }

    .heading {
        margin-bottom: 25px;
    }

        .heading h1 {
            color: #5D4037;
            font-size: 30px;
            margin-bottom: 8px;
        }

        .heading p {
            color: #666;
            margin: 0;
        }

    .summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .card {
        background: #fff;
        padding: 25px 20px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
    }

        .card h4 {
            color: #777;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .card h2 {
            color: #5D4037;
            font-size: 27px;
            margin: 0;
        }

    .controls {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

        .controls input {
            padding: 12px;
            border-radius: 7px;
            border: 1px solid #ccc;
            background: #fff;
            font-size: 14px;
            width: 280px;
        }

    .table-container {
        background: #fff;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
        overflow-x: auto;
    }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

        .orders-table th {
            background: #FFB347;
            color: #000;
            padding: 15px 12px;
            text-align: center;
            white-space: nowrap;
        }

        .orders-table td {
            padding: 15px 12px;
            text-align: center;
            border-bottom: 1px solid #eee;
            font-size: 14px;
            vertical-align: middle;
        }

        .orders-table tbody tr:hover {
            background: #fffaf2;
        }

    .order-id {
        font-weight: 600;
        color: #5D4037;
    }

    .status {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .pending {
        background: #fff2cc;
        color: #9a7200;
    }

    .preparing {
        background: #cfe5ff;
        color: #084298;
    }

    .delivered {
        background: #d4edda;
        color: #0f5132;
    }

    .cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    .accepted {
        background: #e2e3e5;
        color: #41464b;
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #666;
    }

        .empty-state i {
            font-size: 40px;
            color: #FFB347;
            margin-bottom: 15px;
        }

        .empty-state h3 {
            color: #5D4037;
            margin-bottom: 8px;
        }

        .empty-state p {
            margin: 0;
        }

    @@media (max-width: 1000px) {

        .summary {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {

        .summary {
            grid-template-columns: 1fr;
        }

        .controls {
            flex-direction: column;
        }

            .controls input {
                width: 100%;
            }
    }

</style>


<div class="orders-page">

    <!-- PAGE HEADING -->

    <div class="heading">

        <h1>Order Management</h1>

        <p>
            Monitor customer orders.
        </p>

    </div>


    <!-- SUMMARY -->

    <div class="summary">

        <div class="card">

            <h4>Total Orders</h4>

            <h2>
                @totalOrders
            </h2>

        </div>


        <div class="card">

            <h4>Pending</h4>

            <h2>
                @pendingOrders
            </h2>

        </div>


        <div class="card">

            <h4>Preparing</h4>

            <h2>
                @preparingOrders
            </h2>

        </div>


        <div class="card">

            <h4>Delivered</h4>

            <h2>
                @deliveredOrders
            </h2>

        </div>

    </div>


    <!-- SEARCH -->

    <div class="controls">

        <input type="text"
               id="orderSearch"
               placeholder="Search customer..."
               autocomplete="off" />

    </div>


    <!-- ORDERS TABLE -->

    <div class="table-container">

        @if (Model != null && Model.Any())
        {
            <table class="orders-table"
                   id="ordersTable">

                <thead>

                    <tr>

                        <th>Order ID</th>

                        <th>Customer</th>

                        <th>Kitchen</th>

                        <th>Amount</th>

                        <th>Payment</th>

                        <th>Status</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var order in Model)
                    {
                        var kitchenName =
                        order.Kitchen != null
                        ? order.Kitchen.Name
                        : "N/A";

                        var customerName = !string.IsNullOrWhiteSpace(order.CustomerAccount?.Name)
                            ? order.CustomerAccount.Name
                            : (!string.IsNullOrWhiteSpace(order.Customer) && !order.Customer.Contains("@")
                                ? order.Customer
                                : (order.CustomerAccount?.Name ?? order.Customer ?? "N/A"));

                        var orderStatus =
                        order.Status ?? "N/A";

                        <tr data-customer="@customerName.ToLowerInvariant()">

                            <!-- ORDER ID -->

                            <td class="order-id">
                                #@order.Id
                            </td>


                            <!-- CUSTOMER -->

                            <td class="customer-name">
                                @customerName
                            </td>


                            <!-- KITCHEN -->

                            <td>
                                @kitchenName
                            </td>


                            <!-- AMOUNT -->

                            <td>
                                Rs. @order.Total.ToString("N0")
                            </td>


                            <!-- PAYMENT -->

                            <td>
                                @order.PaymentMethod
                            </td>


                            <!-- STATUS -->

                            <td>

                                @if (orderStatus == "Order Placed")
                                {
                                    <span class="status pending">
                                        Order Placed
                                    </span>
                                }
                                else if (orderStatus == "Accepted")
                                {
                                    <span class="status accepted">
                                        Accepted
                                    </span>
                                }
                                else if (orderStatus == "Preparing")
                                {
                                    <span class="status preparing">
                                        Preparing
                                    </span>
                                }
                                else if (orderStatus == "Out for Delivery")
                                {
                                    <span class="status preparing">
                                        Out for Delivery
                                    </span>
                                }
                                else if (orderStatus == "Delivered")
                                {
                                    <span class="status delivered">
                                        Delivered
                                    </span>
                                }
                                else if (orderStatus == "Cancelled")
                                {
                                    <span class="status cancelled">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="status accepted">
                                        @orderStatus
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-state">

                <i class="fa-solid fa-cart-shopping"></i>

                <h3>No Orders Found</h3>

                <p>
                    There are currently no orders in the database.
                </p>

            </div>
        }

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("orderSearch");

        function filterOrders() {

            const searchValue =
                searchInput.value
                    .trim()
                    .toLowerCase();

            const rows =
                document.querySelectorAll(
                    "#ordersTable tbody tr"
                );

            rows.forEach(function (row) {

                const customer =
                    row.dataset.customer || "";

                if (customer.includes(searchValue)) {

                    row.style.display = "";

                } else {

                    row.style.display = "none";

                }

            });

        }

        if (searchInput) {

            searchInput.addEventListener(
                "input",
                filterOrders
            );

        }

    });

</script>
