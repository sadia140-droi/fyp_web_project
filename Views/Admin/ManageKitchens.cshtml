@model List<Cloud_Kitchen_web_App.Models.Kitchen>

@{
    ViewData["Title"] = "Manage Kitchens";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>

    .kitchen-page {
        width: 100%;
    }

    .page-header {
        margin-bottom: 25px;
    }

        .page-header h1 {
            color: #5D4037;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #666;
            margin: 0;
        }

    .summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: #fff;
        padding: 22px;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

        .summary-card h4 {
            color: #777;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .summary-card h2 {
            color: #5D4037;
            margin: 0;
            font-size: 28px;
        }

    .table-container {
        background: #fff;
        padding: 20px;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        overflow-x: auto;
    }

    .kitchen-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px;
    }

        .kitchen-table th {
            background: #FFB347;
            color: #5D4037;
            padding: 14px;
            text-align: center;
            white-space: nowrap;
        }

        .kitchen-table td {
            padding: 14px;
            text-align: center;
            border-bottom: 1px solid #eee;
            color: #333;
            vertical-align: middle;
        }

        .kitchen-table tr:hover {
            background: #fffaf2;
        }

    .status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .pending {
        background: #fff3cd;
        color: #856404;
    }

    .approved {
        background: #d1e7dd;
        color: #0f5132;
    }

    .rejected {
        background: #f8d7da;
        color: #842029;
    }

    .open {
        background: #d1e7dd;
        color: #0f5132;
    }

    .closed {
        background: #e2e3e5;
        color: #41464b;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px;
    }

    .action-form {
        display: inline-block;
        margin: 0;
    }

    .action-btn {
        border: none;
        border-radius: 6px;
        padding: 8px 11px;
        color: white;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
    }

    .approve-btn {
        background: #198754;
    }

    .reject-btn {
        background: #dc3545;
    }

    .toggle-btn {
        background: #FF9800;
    }

    .delete-btn {
        background: #343a40;
    }

    .action-btn:hover {
        opacity: 0.85;
    }

    .reject-input {
        width: 160px;
        padding: 7px;
        border: 1px solid #ccc;
        border-radius: 5px;
        margin-bottom: 5px;
    }

    .message {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .success-message {
        background: #d1e7dd;
        color: #0f5132;
    }

    .error-message {
        background: #f8d7da;
        color: #842029;
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #666;
    }

        .empty-state i {
            font-size: 40px;
            color: #FFB347;
            margin-bottom: 15px;
        }

        .empty-state h3 {
            color: #5D4037;
            margin-bottom: 8px;
        }

    @@media (max-width: 1100px) {

        .summary {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {

        .summary {
            grid-template-columns: 1fr;
        }

        .page-header h1 {
            font-size: 24px;
        }

        .table-container {
            padding: 10px;
        }
    }

</style>


<div class="kitchen-page">

    <!-- PAGE HEADER -->

    <div class="page-header">

        <h1>Manage Kitchens</h1>

        <p>
            Manage kitchen registrations, approvals and availability.
        </p>

    </div>


    <!-- MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="message success-message">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="message error-message">
            @TempData["Error"]
        </div>
    }


    <!-- SUMMARY -->

    <div class="summary">

        <div class="summary-card">

            <h4>Total Kitchens</h4>

            <h2>
                @(Model?.Count ?? 0)
            </h2>

        </div>


        <div class="summary-card">

            <h4>Approved</h4>

            <h2>
                @(Model?.Count(k => k.ApprovalStatus == "Approved") ?? 0)
            </h2>

        </div>


        <div class="summary-card">

            <h4>Pending</h4>

            <h2>
                @(Model?.Count(k => k.ApprovalStatus == "Pending") ?? 0)
            </h2>

        </div>


        <div class="summary-card">

            <h4>Rejected</h4>

            <h2>
                @(Model?.Count(k => k.ApprovalStatus == "Rejected") ?? 0)
            </h2>

        </div>

    </div>


    <!-- KITCHENS TABLE -->

    <div class="table-container">

        @if (Model != null && Model.Any())
        {
            <table class="kitchen-table">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Kitchen</th>

                        <th>Owner</th>

                        <th>Cuisine</th>

                        <th>Location</th>

                        <th>Approval</th>

                        <th>Availability</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var kitchen in Model)
                    {
                        <tr>

                            <!-- ID -->

                            <td>
                                #@kitchen.Id
                            </td>


                            <!-- KITCHEN -->

                            <td>
                                <strong>
                                    @kitchen.Name
                                </strong>
                            </td>


                            <!-- OWNER -->

                            <td>

                                @if (kitchen.KitchenOwner != null)
                                {
                                    <div>
                                        @kitchen.KitchenOwner.Name
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(kitchen.KitchenOwner.Email))
                                    {
                                        <small>
                                            @kitchen.KitchenOwner.Email
                                        </small>
                                    }
                                }
                                else
                                {
                                    <span>
                                        N/A
                                    </span>
                                }

                            </td>


                            <!-- CUISINE -->

                            <td>
                                @if (string.IsNullOrWhiteSpace(kitchen.Cuisine))
                                {
                                    <span>N/A</span>
                                }
                                else
                                {
                                    @kitchen.Cuisine
                                }
                            </td>


                            <!-- LOCATION -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(kitchen.Area))
                                {
                                    <div>
                                        @kitchen.Area
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(kitchen.City))
                                {
                                    <small>
                                        @kitchen.City
                                    </small>
                                }

                            </td>


                            <!-- APPROVAL -->

                            <td>

                                @if (kitchen.ApprovalStatus == "Approved")
                                {
                                    <span class="status approved">
                                        Approved
                                    </span>
                                }
                                else if (kitchen.ApprovalStatus == "Rejected")
                                {
                                    <span class="status rejected">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="status pending">
                                        Pending
                                    </span>
                                }

                            </td>


                            <!-- AVAILABILITY -->

                            <td>

                                @if (kitchen.IsOpen)
                                {
                                    <span class="status open">
                                        Open
                                    </span>
                                }
                                else
                                {
                                    <span class="status closed">
                                        Closed
                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->

                            <td>

                                <div class="actions">


                                    <!-- APPROVE -->
                                    @if (kitchen.ApprovalStatus != "Approved")
                                    {
                                        <form asp-controller="Admin"
                                              asp-action="ApproveKitchen"
                                              method="post"
                                              class="action-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@kitchen.Id" />

                                            <button type="submit"
                                                    class="action-btn approve-btn"
                                                    onclick="return confirm('Approve this kitchen?');">

                                                Approve

                                            </button>

                                        </form>
                                    }


                                    <!-- REJECT -->
                                    @if (kitchen.ApprovalStatus != "Rejected")
                                    {
                                        <form asp-controller="Admin"
                                              asp-action="RejectKitchen"
                                              method="post"
                                              class="action-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@kitchen.Id" />

                                            <input type="text"
                                                   name="rejectionReason"
                                                   class="reject-input"
                                                   placeholder="Reason"
                                                   required />

                                            <button type="submit"
                                                    class="action-btn reject-btn"
                                                    onclick="return confirm('Reject this kitchen?');">

                                                Reject

                                            </button>

                                        </form>
                                    }


                                    <!-- OPEN / CLOSE -->
                                    @if (kitchen.ApprovalStatus == "Approved")
                                    {
                                        <form asp-controller="Admin"
                                              asp-action="ToggleKitchenStatus"
                                              method="post"
                                              class="action-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@kitchen.Id" />

                                            <button type="submit"
                                                    class="action-btn toggle-btn"
                                                    onclick="return confirm('@(kitchen.IsOpen ? "Close" : "Open") this kitchen?');">

                                                @(kitchen.IsOpen ? "Close" : "Open")

                                            </button>

                                        </form>
                                    }


                                    <!-- DELETE -->

                                    <form asp-controller="Admin"
                                          asp-action="DeleteKitchen"
                                          method="post"
                                          class="action-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@kitchen.Id" />

                                        <button type="submit"
                                                class="action-btn delete-btn"
                                                onclick="return confirm('Delete this kitchen permanently?');">

                                            Delete

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-state">

                <i class="fa-solid fa-store"></i>

                <h3>No Kitchens Found</h3>

                <p>
                    There are currently no kitchens in the database.
                </p>

            </div>
        }

    </div>

</div>
