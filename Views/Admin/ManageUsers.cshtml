@model List<Cloud_Kitchen_web_App.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var totalUsers = Model?.Count ?? 0;

    var customerCount = Model?.Count(u =>
        string.Equals(
            u.UserRole,
            "Customer",
            StringComparison.OrdinalIgnoreCase)) ?? 0;

    var sellerCount = Model?.Count(u =>
        string.Equals(
            u.UserRole,
            "Seller",
            StringComparison.OrdinalIgnoreCase)) ?? 0;

    var blockedCount = Model?.Count(u =>
        u.LockoutEnd.HasValue &&
        u.LockoutEnd.Value > DateTimeOffset.UtcNow) ?? 0;
}


<style>

    .users-page {
        width: 100%;
    }

    .heading {
        margin-bottom: 25px;
    }

        .heading h1 {
            color: #5D4037;
            margin-bottom: 6px;
            font-size: 30px;
        }

        .heading p {
            color: #666;
            margin: 0;
        }


    /* ================= CARDS ================= */

    .cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .card {
        background: #fff;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
    }

        .card h3 {
            font-size: 15px;
            color: #777;
            margin-bottom: 10px;
        }

        .card h1 {
            color: #5D4037;
            margin: 0;
            font-size: 28px;
        }


    /* ================= CONTROLS ================= */

    .controls {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

        .controls input,
        .controls select {
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: #fff;
            font-size: 14px;
        }

        .controls input {
            width: 280px;
        }

        .controls select {
            width: 200px;
        }


    /* ================= TABLE ================= */

    .table-container {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

        .users-table th {
            background: #FFB347;
            color: #5D4037;
            padding: 15px;
            text-align: center;
            white-space: nowrap;
        }

        .users-table td {
            padding: 14px;
            border-bottom: 1px solid #eee;
            text-align: center;
            vertical-align: middle;
        }

        .users-table tbody tr:hover {
            background: #fffaf2;
        }


    /* ================= STATUS ================= */

    .status {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .active {
        background: #d4edda;
        color: #155724;
    }

    .blocked {
        background: #f8d7da;
        color: #721c24;
    }


    /* ================= ROLE ================= */

    .role {
        font-weight: 600;
        color: #5D4037;
    }


    /* ================= BUTTONS ================= */

    .action-form {
        display: inline-block;
        margin: 2px;
    }

    .action-btn {
        border: none;
        padding: 8px 11px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        color: #fff;
        text-decoration: none;
        display: inline-block;
    }

    .edit-btn,
    .view-btn {
        background: #17a2b8;
    }

    .view-btn:hover {
        background: #138496;
    }

    .block-btn {
        background: #dc3545;
    }

    .unblock-btn {
        background: #FF9800;
    }

    .delete-btn {
        background: #212529;
    }

    .action-btn:hover {
        opacity: .85;
    }

    /* ================= USER DETAILS MODAL ================= */
    .user-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(43, 27, 24, 0.65);
        backdrop-filter: blur(4px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: modalFadeIn 0.2s ease-out;
    }

    .user-modal-card {
        background: #ffffff;
        width: 100%;
        max-width: 520px;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        overflow: hidden;
        animation: modalScaleUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        border: 1px solid rgba(0, 0, 0, 0.08);
    }

    @@keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes modalScaleUp {
        from { opacity: 0; transform: scale(0.94) translateY(8px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .user-modal-header {
        background: linear-gradient(135deg, #FFB347 0%, #ff9800 100%);
        padding: 18px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .user-modal-title-box {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .user-modal-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #5D4037;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 700;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        flex-shrink: 0;
    }

    .user-modal-name {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 700;
        color: #5D4037;
    }

    .user-modal-email {
        margin: 2px 0 0;
        font-size: 0.85rem;
        color: rgba(93, 64, 55, 0.9);
        word-break: break-all;
    }

    .user-modal-close {
        background: transparent;
        border: none;
        font-size: 26px;
        line-height: 1;
        color: #5D4037;
        cursor: pointer;
        padding: 0;
        margin-left: 10px;
        transition: transform 0.2s;
    }

    .user-modal-close:hover {
        transform: scale(1.15);
    }

    .user-modal-badges {
        display: flex;
        gap: 8px;
        padding: 12px 24px;
        flex-wrap: wrap;
        background: #faf7f2;
        border-bottom: 1px solid #f0e6d9;
    }

    .modal-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .badge-role {
        background: #e9ecef;
        color: #495057;
    }

    .badge-status.active {
        background: #d4edda;
        color: #155724;
    }

    .badge-status.blocked {
        background: #f8d7da;
        color: #721c24;
    }

    .badge-verified {
        background: #cff4fc;
        color: #055160;
    }

    .user-modal-grid {
        padding: 18px 24px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    @@media (max-width: 500px) {
        .user-modal-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }
    }

    .user-modal-item {
        display: flex;
        flex-direction: column;
        background: #fdfaf6;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid #f3ece3;
    }

    .detail-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #8c7667;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 3px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .detail-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: #3e2723;
        word-break: break-all;
    }

    .detail-code {
        font-family: monospace;
        font-size: 0.82rem;
        color: #555;
    }

    .user-modal-footer {
        padding: 14px 24px 18px;
        background: #ffffff;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #f0e6d9;
    }

    .modal-btn {
        border: none;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .modal-btn-danger {
        background: #dc3545;
        color: #fff;
    }

    .modal-btn-danger:hover {
        background: #c82333;
    }

    .modal-btn-warning {
        background: #ff9800;
        color: #fff;
    }

    .modal-btn-warning:hover {
        background: #e68900;
    }

    .modal-btn-secondary {
        background: #5D4037;
        color: #fff;
    }

    .modal-btn-secondary:hover {
        background: #4a332c;
    }


    /* ================= EMPTY STATE ================= */

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #666;
    }

        .empty-state i {
            font-size: 40px;
            color: #FFB347;
            margin-bottom: 15px;
        }

        .empty-state h3 {
            color: #5D4037;
            margin-bottom: 8px;
        }

        .empty-state p {
            margin: 0;
        }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 1100px) {

        .cards {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {

        .cards {
            grid-template-columns: 1fr;
        }

        .controls {
            flex-direction: column;
        }

            .controls input,
            .controls select {
                width: 100%;
            }

        .heading h1 {
            font-size: 24px;
        }
    }

</style>


<div class="users-page">

    <!-- ================= HEADING ================= -->

    <div class="heading">

        <h1>Manage Users</h1>

        <p>
            Monitor and manage registered users.
        </p>

    </div>


    <!-- ================= SUMMARY CARDS ================= -->

    <div class="cards">

        <div class="card">

            <h3>
                Total Users
            </h3>

            <h1>
                @totalUsers
            </h1>

        </div>


        <div class="card">

            <h3>
                Customers
            </h3>

            <h1>
                @customerCount
            </h1>

        </div>


        <div class="card">

            <h3>
                Sellers
            </h3>

            <h1>
                @sellerCount
            </h1>

        </div>


        <div class="card">

            <h3>
                Blocked Users
            </h3>

            <h1>
                @blockedCount
            </h1>

        </div>

    </div>


    <!-- ================= SEARCH / FILTER ================= -->

    <div class="controls">

        <input type="text"
               id="userSearch"
               placeholder="Search user..."
               autocomplete="off" />


        <select id="roleFilter">

            <option value="all">
                All Roles
            </option>

            <option value="Customer">
                Customer
            </option>

            <option value="Seller">
                Seller
            </option>

            <option value="Admin">
                Admin
            </option>

        </select>


        <select id="statusFilter">

            <option value="all">
                All Status
            </option>

            <option value="Active">
                Active
            </option>

            <option value="Blocked">
                Blocked
            </option>

        </select>

    </div>


    <!-- ================= USERS TABLE ================= -->

    <div class="table-container">

        @if (Model != null && Model.Any())
        {
            <table class="users-table"
                   id="userTable">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Name</th>

                        <th>Email</th>

                        <th>Role</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var user in Model)
                    {
                        var isBlocked =
                        user.LockoutEnd.HasValue &&
                        user.LockoutEnd.Value > DateTimeOffset.UtcNow;

                        var displayName =
                        string.IsNullOrWhiteSpace(user.FullName)
                        ? "N/A"
                        : user.FullName;

                        var displayEmail =
                        string.IsNullOrWhiteSpace(user.Email)
                        ? "N/A"
                        : user.Email;

                        var displayRole =
                        string.IsNullOrWhiteSpace(user.UserRole)
                        ? "Customer"
                        : user.UserRole;

                        var displayPhone =
                        string.IsNullOrWhiteSpace(user.PhoneNumber)
                        ? "N/A"
                        : user.PhoneNumber;

                        var displayCity =
                        string.IsNullOrWhiteSpace(user.City)
                        ? "N/A"
                        : user.City;

                        var sellerStatus =
                        string.IsNullOrWhiteSpace(user.SellerStatus)
                        ? "Pending"
                        : user.SellerStatus;

                        <tr data-search="@($"{displayName} {displayEmail} {user.UserName}").ToLowerInvariant()"
                            data-role="@displayRole"
                            data-status="@(isBlocked ? "Blocked" : "Active")">

                            <!-- ID -->

                            <td>
                                @user.Id
                            </td>


                            <!-- NAME -->

                            <td>
                                <strong>
                                    @displayName
                                </strong>
                            </td>


                            <!-- EMAIL -->

                            <td>
                                @displayEmail
                            </td>


                            <!-- ROLE -->

                            <td>

                                <span class="role">
                                    @displayRole
                                </span>

                            </td>


                            <!-- STATUS -->

                            <td>

                                @if (isBlocked)
                                {
                                    <span class="status blocked">
                                        Blocked
                                    </span>
                                }
                                else
                                {
                                    <span class="status active">
                                        Active
                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->

                            <td>
                                
                                <!-- VIEW -->
                                <button type="button"
                                        class="action-btn view-btn"
                                        data-user-id="@user.Id"
                                        data-user-name="@displayName"
                                        data-user-email="@displayEmail"
                                        data-user-phone="@displayPhone"
                                        data-user-city="@displayCity"
                                        data-user-role="@displayRole"
                                        data-user-status="@(isBlocked ? "Blocked" : "Active")"
                                        data-user-sellerstatus="@sellerStatus"
                                        data-user-emailconfirmed="@(user.EmailConfirmed ? "Yes" : "No")"
                                        onclick="openUserDetailsModal(this)">
                                    <i class="fa-solid fa-eye"></i> View
                                </button>

                                <!-- BLOCK / UNBLOCK -->

                                <form asp-controller="Admin"
                                      asp-action="ToggleUserStatus"
                                      method="post"
                                      class="action-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    @if (isBlocked)
                                    {
                                        <button type="submit"
                                                class="action-btn unblock-btn"
                                                onclick="return confirm('Unblock this user?');">

                                            Unblock

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="action-btn block-btn"
                                                onclick="return confirm('Block this user?');">

                                            Block

                                        </button>
                                    }

                                </form>


                                <!-- DELETE -->

                                <form asp-controller="Admin"
                                      asp-action="DeleteUser"
                                      method="post"
                                      class="action-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    <button type="submit"
                                            class="action-btn delete-btn"
                                            onclick="return confirm('Delete this user permanently?');">

                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-state">

                <i class="fa-solid fa-users"></i>

                <h3>No Users Found</h3>

                <p>
                    There are currently no users in the database.
                </p>

            </div>
        }

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("userSearch");

        const roleFilter =
            document.getElementById("roleFilter");

        const statusFilter =
            document.getElementById("statusFilter");


        function filterUsers() {

            const searchValue =
                searchInput.value
                    .trim()
                    .toLowerCase();

            const selectedRole =
                roleFilter.value;

            const selectedStatus =
                statusFilter.value;


            const rows =
                document.querySelectorAll(
                    "#userTable tbody tr"
                );


            rows.forEach(function (row) {

                const searchData =
                    row.dataset.search || "";

                const role =
                    row.dataset.role || "";

                const status =
                    row.dataset.status || "";


                const matchesSearch =
                    searchData.includes(searchValue);

                const matchesRole =
                    selectedRole === "all" ||
                    role === selectedRole;

                const matchesStatus =
                    selectedStatus === "all" ||
                    status === selectedStatus;


                if (
                    matchesSearch &&
                    matchesRole &&
                    matchesStatus
                ) {

                    row.style.display = "";

                }
                else {

                    row.style.display = "none";

                }

            });

        }


        if (searchInput) {

            searchInput.addEventListener(
                "input",
                filterUsers
            );

        }


        if (roleFilter) {

            roleFilter.addEventListener(
                "change",
                filterUsers
            );

        }


        if (statusFilter) {

            statusFilter.addEventListener(
                "change",
                filterUsers
            );

        }

    });

    /* ================= USER DETAILS MODAL JS ================= */
    function openUserDetailsModal(btn) {
        const userId = btn.getAttribute('data-user-id') || 'N/A';
        const userName = btn.getAttribute('data-user-name') || 'N/A';
        const userEmail = btn.getAttribute('data-user-email') || 'N/A';
        const userPhone = btn.getAttribute('data-user-phone') || 'N/A';
        const userCity = btn.getAttribute('data-user-city') || 'N/A';
        const userRole = btn.getAttribute('data-user-role') || 'Customer';
        const userStatus = btn.getAttribute('data-user-status') || 'Active';
        const sellerStatus = btn.getAttribute('data-user-sellerstatus') || 'Pending';
        const emailConfirmed = btn.getAttribute('data-user-emailconfirmed') === 'Yes';

        document.getElementById('modalUserId').textContent = userId;
        document.getElementById('modalUserName').textContent = userName;
        document.getElementById('modalUserEmail').textContent = userEmail;
        document.getElementById('modalUserPhone').textContent = userPhone;
        document.getElementById('modalUserCity').textContent = userCity;
        document.getElementById('modalAccountStatus').textContent = userStatus;

        // Avatar initial
        const initial = userName.trim() !== 'N/A' && userName.trim().length > 0 ? userName.trim().charAt(0).toUpperCase() : 'U';
        document.getElementById('modalUserInitial').textContent = initial;

        // Badges
        const roleBadge = document.getElementById('modalRoleBadge');
        roleBadge.textContent = userRole;

        const statusBadge = document.getElementById('modalStatusBadge');
        statusBadge.textContent = userStatus;
        statusBadge.className = 'modal-badge badge-status ' + (userStatus === 'Blocked' ? 'blocked' : 'active');

        const emailBadge = document.getElementById('modalEmailBadge');
        if (emailConfirmed) {
            emailBadge.innerHTML = '<i class="fa-solid fa-circle-check"></i> Email Confirmed';
            emailBadge.className = 'modal-badge badge-verified';
            emailBadge.style.display = 'inline-flex';
        } else {
            emailBadge.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> Unverified Email';
            emailBadge.className = 'modal-badge badge-status blocked';
            emailBadge.style.display = 'inline-flex';
        }

        // Seller row
        const sellerRow = document.getElementById('modalSellerStatusRow');
        if (userRole.toLowerCase() === 'seller') {
            sellerRow.style.display = 'flex';
            document.getElementById('modalSellerStatus').textContent = sellerStatus;
        } else {
            sellerRow.style.display = 'none';
        }

        // Toggle form
        document.getElementById('modalToggleUserId').value = userId;
        const toggleBtn = document.getElementById('modalToggleBtn');
        if (userStatus === 'Blocked') {
            toggleBtn.className = 'modal-btn modal-btn-warning';
            toggleBtn.innerHTML = '<i class="fa-solid fa-lock-open"></i> Unblock User';
            toggleBtn.onclick = function() { return confirm('Unblock this user?'); };
        } else {
            toggleBtn.className = 'modal-btn modal-btn-danger';
            toggleBtn.innerHTML = '<i class="fa-solid fa-ban"></i> Block User';
            toggleBtn.onclick = function() { return confirm('Block this user?'); };
        }

        const modal = document.getElementById('userDetailsModal');
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeUserDetailsModal() {
        const modal = document.getElementById('userDetailsModal');
        if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }
    }

    function handleModalBackdropClick(e) {
        if (e.target && e.target.id === 'userDetailsModal') {
            closeUserDetailsModal();
        }
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeUserDetailsModal();
        }
    });

</script>

<!-- USER DETAILS MODAL -->
<div id="userDetailsModal" class="user-modal-overlay" style="display: none;" onclick="handleModalBackdropClick(event)">
    <div class="user-modal-card" role="dialog" aria-modal="true" aria-labelledby="modalUserName">
        
        <!-- MODAL HEADER -->
        <div class="user-modal-header">
            <div class="user-modal-title-box">
                <div class="user-modal-avatar" id="modalUserInitial">U</div>
                <div>
                    <h2 id="modalUserName" class="user-modal-name">User Name</h2>
                    <p id="modalUserEmail" class="user-modal-email">user@example.com</p>
                </div>
            </div>
            <button type="button" class="user-modal-close" onclick="closeUserDetailsModal()" aria-label="Close">&times;</button>
        </div>

        <!-- BADGES -->
        <div class="user-modal-badges">
            <span id="modalRoleBadge" class="modal-badge badge-role">Customer</span>
            <span id="modalStatusBadge" class="modal-badge badge-status">Active</span>
            <span id="modalEmailBadge" class="modal-badge badge-verified"><i class="fa-solid fa-check-circle"></i> Email Confirmed</span>
        </div>

        <!-- DETAILS GRID -->
        <div class="user-modal-grid">
            <div class="user-modal-item">
                <span class="detail-label"><i class="fa-solid fa-id-card"></i> User ID</span>
                <span id="modalUserId" class="detail-value detail-code">#12345</span>
            </div>

            <div class="user-modal-item">
                <span class="detail-label"><i class="fa-solid fa-phone"></i> Phone Number</span>
                <span id="modalUserPhone" class="detail-value">N/A</span>
            </div>

            <div class="user-modal-item">
                <span class="detail-label"><i class="fa-solid fa-location-dot"></i> City</span>
                <span id="modalUserCity" class="detail-value">N/A</span>
            </div>

            <div class="user-modal-item" id="modalSellerStatusRow" style="display: none;">
                <span class="detail-label"><i class="fa-solid fa-store"></i> Seller Status</span>
                <span id="modalSellerStatus" class="detail-value">Approved</span>
            </div>

            <div class="user-modal-item">
                <span class="detail-label"><i class="fa-solid fa-shield-halved"></i> Account Status</span>
                <span id="modalAccountStatus" class="detail-value">Active</span>
            </div>
        </div>

        <!-- MODAL ACTIONS -->
        <div class="user-modal-footer">
            <form id="modalToggleStatusForm" asp-controller="Admin" asp-action="ToggleUserStatus" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalToggleUserId" value="" />
                <button type="submit" id="modalToggleBtn" class="modal-btn modal-btn-danger">
                    <i class="fa-solid fa-ban"></i> Block User
                </button>
            </form>

            <button type="button" class="modal-btn modal-btn-secondary" onclick="closeUserDetailsModal()">
                Close
            </button>
        </div>

    </div>
</div>

