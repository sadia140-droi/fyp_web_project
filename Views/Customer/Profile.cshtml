@model Cloud_Kitchen_web_App.Models.CustomerModel
@{
    ViewData["Title"] = "My Profile - Cloud Kitchen";
    Layout = "_CustomerLayout";
}

@section Styles {
    <style>
        :root {
            --soft-orange: #FFB347;
            --dark-brown: #33221C;
            --card-border: #E8E8E8;
            --text-muted: #706461;
        }

        .profile-wrapper {
            max-width: 720px;
            margin: 30px auto;
            padding: 0 15px;
        }

        /* Foodpanda Style Hero Card */
        .profile-hero-card {
            background: white;
            border-radius: 20px;
            padding: 28px;
            border: 1px solid var(--card-border);
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
        }

            .profile-hero-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 8px;
                height: 100%;
                background: var(--soft-orange);
            }

        .avatar-box {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--soft-orange), #ff9800);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            font-weight: 800;
            box-shadow: 0 6px 15px rgba(255, 179, 71, 0.35);
            flex-shrink: 0;
            overflow: hidden;
        }

        .profile-hero-info h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--dark-brown);
            margin-bottom: 4px;
        }

        .profile-hero-info p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin: 0;
        }

        /* Content Card */
        .profile-content-card {
            background: white;
            border-radius: 20px;
            padding: 28px;
            border: 1px solid var(--card-border);
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        }

        .field-group label {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 16px;
            border: 1px solid #E2DCD2;
            background-color: #FAFAFA;
            font-size: 0.95rem;
            color: var(--dark-brown);
            transition: all 0.25s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--soft-orange);
                background-color: #FFF;
                box-shadow: 0 0 0 4px rgba(255, 179, 71, 0.15);
            }

        .edit-profile-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 12px;
            background: var(--soft-orange);
            color: var(--dark-brown);
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(255, 179, 71, 0.25);
        }

            .edit-profile-btn:hover {
                background: #ffa726;
                transform: translateY(-1px);
            }

        @@media (max-width: 576px) {
            .profile-hero-card {
                flex-direction: column;
                text-align: center;
                padding: 20px;
            }

                .profile-hero-card::before {
                    width: 100%;
                    height: 6px;
                    top: 0;
                }
        }
    </style>
}

<div class="profile-wrapper">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @{
        var cName = string.IsNullOrWhiteSpace(Model?.Name) ? "Customer" : Model.Name.Trim();
        var cParts = cName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var cInitials = cParts.Length > 1 
            ? $"{cParts[0][0]}{cParts[cParts.Length - 1][0]}".ToUpper() 
            : (cParts.Length > 0 && cParts[0].Length > 0 ? cParts[0].Substring(0, 1).ToUpper() : "C");
        var hasCustomerPhoto = !string.IsNullOrWhiteSpace(Model?.ProfilePictureUrl) && !Model.ProfilePictureUrl.Contains("profile.png");
    }

    <div class="profile-hero-card">
        <div class="avatar-box overflow-hidden" title="@cName">
            @if (hasCustomerPhoto)
            {
                <img src="@Url.Content("~/" + Model!.ProfilePictureUrl.TrimStart('/'))" alt="@cName" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" />
                <span style="display:none; width:100%; height:100%; align-items:center; justify-content:center; text-transform:uppercase; font-size:3rem; font-weight:800; color:white;">@cInitials</span>
            }
            else
            {
                <span style="display:inline-flex; width:100%; height:100%; align-items:center; justify-content:center; text-transform:uppercase; font-size:3rem; font-weight:800; color:white;">@cInitials</span>
            }
        </div>
        <div class="profile-hero-info">
            <h2>@Model?.Name</h2>
            <p><i class="fas fa-envelope me-1" style="color: var(--soft-orange);"></i>@Model?.Email</p>
        </div>
    </div>

    <div class="profile-content-card">
        <form asp-controller="Customer" asp-action="Profile" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ProfilePictureUrl" />

            <div class="field-group mb-3">
                <label><i class="fas fa-image" style="color: var(--soft-orange);"></i> Profile Picture Update</label>
                <input type="file" name="ProfileImage" class="form-control" accept="image/*" />
            </div>

            <div class="field-group mb-3">
                <label><i class="fas fa-user" style="color: var(--soft-orange);"></i> Full Name</label>
                <input type="text" asp-for="Name" class="form-control" placeholder="Enter full name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="field-group mb-3">
                <label><i class="fas fa-envelope" style="color: var(--soft-orange);"></i> Email Address</label>
                <input type="email" asp-for="Email" class="form-control" placeholder="Enter email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="field-group mb-3">
                <label><i class="fas fa-phone" style="color: var(--soft-orange);"></i> Mobile Number</label>
                <input type="text" asp-for="Phone" class="form-control" placeholder="Enter mobile number" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="field-group mb-3">
                <label><i class="fas fa-map-marker-alt" style="color: var(--soft-orange);"></i> Address</label>
                <input type="text" asp-for="Address" class="form-control" placeholder="Enter address" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <button type="submit" class="edit-profile-btn mt-3">
                <i class="fas fa-save me-2"></i> Save Profile Changes
            </button>
        </form>
    </div>
</div>