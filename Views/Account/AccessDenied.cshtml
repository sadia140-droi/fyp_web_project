@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="login-container" style="max-width: 480px; text-align: center; padding: 40px 30px; margin: 0 auto;">
    <div style="width: 70px; height: 70px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
        <i class="fas fa-shield-alt" style="font-size: 32px; color: #ef4444;"></i>
    </div>

    <h2 style="font-size: 1.6rem; font-weight: 700; color: #3E2723; margin-bottom: 12px;">Access Denied</h2>
    
    <p style="color: #666; font-size: 0.95rem; line-height: 1.5; margin-bottom: 25px;">
        You do not have permission to view this page or order details. Please make sure you are signed into the correct account.
    </p>

    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn" style="background: #FFB347; color: #3E2723; font-weight: 600; padding: 10px 22px; border-radius: 10px; text-decoration: none;">
            <i class="fas fa-home me-1"></i> Back to Home
        </a>
        <a asp-controller="Account" asp-action="Login" class="btn" style="background: #3E2723; color: #fff; font-weight: 600; padding: 10px 22px; border-radius: 10px; text-decoration: none;">
            <i class="fas fa-sign-in-alt me-1"></i> Login
        </a>
    </div>
</div>
