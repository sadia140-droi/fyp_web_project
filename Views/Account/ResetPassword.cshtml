@model CloudKitchen.Controllers.AccountController.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="forgot-container">

    <h2>Reset Password</h2>

    <p>
        Create a new password for your Cloud Kitchen account.
    </p>

    <form asp-controller="Account"
          asp-action="ResetPassword"
          method="post"
          id="resetPasswordForm">

        @Html.AntiForgeryToken()

        <!-- Validation Summary -->
        <div asp-validation-summary="All"
             class="text-danger validation-summary">
        </div>


        <!-- =====================================================
             EMAIL
             ===================================================== -->

        <input asp-for="Email"
               type="email"
               placeholder="Email Address"
               autocomplete="email"
               readonly />


        <!-- =====================================================
             RESET TOKEN
             ===================================================== -->

        <input asp-for="Token"
               type="hidden" />


        <!-- =====================================================
             NEW PASSWORD
             ===================================================== -->

        <div class="password-wrapper">

            <input asp-for="Password"
                   type="password"
                   id="newPassword"
                   placeholder="New Password"
                   autocomplete="new-password"
                   required />

            <button type="button"
                    class="password-toggle"
                    onclick="togglePassword('newPassword', this)"
                    aria-label="Show password">

                <svg class="eye-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M2 12C2 12 5.5 5 12 5C18.5 5 22 12 22 12C22 12 18.5 19 12 19C5.5 19 2 12 2 12Z"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round" />

                    <circle cx="12"
                            cy="12"
                            r="3"
                            stroke="currentColor"
                            stroke-width="2" />

                </svg>

            </button>

        </div>


        <!-- =====================================================
             CONFIRM PASSWORD
             ===================================================== -->

        <div class="password-wrapper">

            <input asp-for="ConfirmPassword"
                   type="password"
                   id="confirmPassword"
                   placeholder="Confirm New Password"
                   autocomplete="new-password"
                   required />

            <button type="button"
                    class="password-toggle"
                    onclick="togglePassword('confirmPassword', this)"
                    aria-label="Show password">

                <svg class="eye-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M2 12C2 12 5.5 5 12 5C18.5 5 22 12 22 12C22 12 18.5 19 12 19C5.5 19 2 12 2 12Z"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round" />

                    <circle cx="12"
                            cy="12"
                            r="3"
                            stroke="currentColor"
                            stroke-width="2" />

                </svg>

            </button>

        </div>


        <!-- =====================================================
             PASSWORD MATCH ERROR
             ===================================================== -->

        <div id="passwordError"
             class="password-error"
             role="alert">
        </div>


        <!-- =====================================================
             RESET PASSWORD BUTTON
             ===================================================== -->

        <button type="submit"
                id="resetPasswordButton">
            Reset Password
        </button>

    </form>


    <!-- =========================================================
         BACK TO LOGIN
         ========================================================= -->

    <div class="back-links">

        <a asp-controller="Account"
           asp-action="Login">
            Back to Login
        </a>

    </div>


    <!-- =========================================================
         BACK TO HOME
         ========================================================= -->

    <a asp-controller="Home"
       asp-action="Index"
       class="back-home">

        ← Back to Home

    </a>

</div>


<!-- =============================================================
     JAVASCRIPT
     ============================================================= -->

<script>

    // =========================================================
    // SHOW / HIDE PASSWORD
    // =========================================================

    function togglePassword(inputId, button) {

        const input = document.getElementById(inputId);
        const eyeIcon = button.querySelector(".eye-icon");

        if (input.type === "password") {

            // Show password
            input.type = "text";

            button.setAttribute(
                "aria-label",
                "Hide password"
            );

            eyeIcon.innerHTML = `
                <path d="M3 3L21 21"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"/>

                <path d="M10.6 10.6
                         A2 2 0 0 0 13.4 13.4"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"/>

                <path d="M9.9 5.2
                         C10.6 5.05 11.3 5 12 5
                         C18.5 5 22 12 22 12
                         C22 12 20.5 15 17.8 17.2"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"/>

                <path d="M6.2 6.8
                         C3.5 8.9 2 12 2 12
                         C2 12 5.5 19 12 19
                         C13.5 19 14.9 18.7 16.1 18.2"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"/>
            `;

        }
        else {

            // Hide password
            input.type = "password";

            button.setAttribute(
                "aria-label",
                "Show password"
            );

            eyeIcon.innerHTML = `
                <path d="M2 12
                         C2 12 5.5 5 12 5
                         C18.5 5 22 12 22 12
                         C22 12 18.5 19 12 19
                         C5.5 19 2 12 2 12Z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"/>

                <circle cx="12"
                        cy="12"
                        r="3"
                        stroke="currentColor"
                        stroke-width="2"/>
            `;
        }
    }


    // =========================================================
    // PASSWORD ELEMENTS
    // =========================================================

    const passwordInput =
        document.getElementById("newPassword");

    const confirmPasswordInput =
        document.getElementById("confirmPassword");

    const passwordError =
        document.getElementById("passwordError");

    const resetPasswordForm =
        document.getElementById("resetPasswordForm");


    // =========================================================
    // CHECK PASSWORDS
    // =========================================================

    function validatePasswords() {

        const password =
            passwordInput.value;

        const confirmPassword =
            confirmPasswordInput.value;


        // Confirm password empty
        if (confirmPassword.length === 0) {

            passwordError.textContent = "";

            passwordInput.classList.remove(
                "password-invalid",
                "password-valid"
            );

            confirmPasswordInput.classList.remove(
                "password-invalid",
                "password-valid"
            );

            return false;
        }


        // EXACTLY THE SAME
        if (password === confirmPassword) {

            passwordError.textContent = "";

            passwordInput.classList.remove(
                "password-invalid"
            );

            confirmPasswordInput.classList.remove(
                "password-invalid"
            );

            passwordInput.classList.add(
                "password-valid"
            );

            confirmPasswordInput.classList.add(
                "password-valid"
            );

            return true;
        }


        // NOT THE SAME
        passwordError.textContent =
            "Passwords do not match.";

        passwordInput.classList.remove(
            "password-valid"
        );

        confirmPasswordInput.classList.remove(
            "password-valid"
        );

        passwordInput.classList.add(
            "password-invalid"
        );

        confirmPasswordInput.classList.add(
            "password-invalid"
        );

        return false;
    }


    // =========================================================
    // CHECK WHILE TYPING
    // =========================================================

    passwordInput.addEventListener(
        "input",
        validatePasswords
    );

    confirmPasswordInput.addEventListener(
        "input",
        validatePasswords
    );


    // =========================================================
    // FINAL CHECK BEFORE SUBMIT
    // =========================================================

    resetPasswordForm.addEventListener(
        "submit",
        function (event) {

            const password =
                passwordInput.value;

            const confirmPassword =
                confirmPasswordInput.value;


            // Empty fields
            if (password.length === 0 ||
                confirmPassword.length === 0) {

                event.preventDefault();

                passwordError.textContent =
                    "Please enter and confirm your password.";

                passwordInput.classList.add(
                    "password-invalid"
                );

                confirmPasswordInput.classList.add(
                    "password-invalid"
                );

                return;
            }


            // EXACT MATCH REQUIRED
            if (password !== confirmPassword) {

                event.preventDefault();

                passwordError.textContent =
                    "Passwords do not match.";

                passwordInput.classList.remove(
                    "password-valid"
                );

                confirmPasswordInput.classList.remove(
                    "password-valid"
                );

                passwordInput.classList.add(
                    "password-invalid"
                );

                confirmPasswordInput.classList.add(
                    "password-invalid"
                );

                confirmPasswordInput.focus();

                return;
            }

            // Same passwords → submit to backend
        }
    );

</script>


<!-- =============================================================
     CSS
     ============================================================= -->

<style>

    /* =========================================================
           PASSWORD WRAPPER
           ========================================================= */

    .forgot-container .password-wrapper {
        position: relative !important;
        width: 100% !important;
        margin-bottom: 16px !important;
    }


        /* =========================================================
           PASSWORD INPUT
           ========================================================= */

        .forgot-container .password-wrapper input {
            width: 100% !important;
            box-sizing: border-box !important;
            padding-right: 52px !important;
        }


        /* =========================================================
           GMAIL STYLE EYE BUTTON
           This overrides global button CSS
           ========================================================= */

        .forgot-container
        .password-wrapper
        button.password-toggle {
            position: absolute !important;
            right: 8px !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            width: 36px !important;
            min-width: 36px !important;
            max-width: 36px !important;
            height: 36px !important;
            min-height: 36px !important;
            max-height: 36px !important;
            margin: 0 !important;
            padding: 6px !important;
            border: none !important;
            border-radius: 50% !important;
            background: transparent !important;
            color: #5f6368 !important;
            box-shadow: none !important;
            cursor: pointer !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            z-index: 20 !important;
        }


            /* =========================================================
           EYE HOVER
           ========================================================= */

            .forgot-container
            .password-wrapper
            button.password-toggle:hover {
                background: rgba(95, 99, 104, 0.08) !important;
                color: #202124 !important;
            }


            /* =========================================================
           EYE FOCUS
           ========================================================= */

            .forgot-container
            .password-wrapper
            button.password-toggle:focus {
                outline: none !important;
                background: transparent !important;
                box-shadow: none !important;
            }


        /* =========================================================
           EYE ICON
           ========================================================= */

        .forgot-container
        .password-wrapper
        .password-toggle
        .eye-icon {
            width: 21px !important;
            height: 21px !important;
            display: block !important;
        }


    /* =========================================================
           PASSWORD ERROR
           ========================================================= */

    .password-error {
        min-height: 22px;
        margin-top: -5px;
        margin-bottom: 12px;
        font-size: 14px;
        font-weight: 500;
        color: #d93025;
    }


    /* =========================================================
           INVALID PASSWORD
           ========================================================= */

    .forgot-container
    .password-wrapper
    input.password-invalid {
        border: 1px solid #d93025 !important;
    }


    /* =========================================================
           VALID PASSWORD
           ========================================================= */

    .forgot-container
    .password-wrapper
    input.password-valid {
        border: 1px solid #188038 !important;
    }


    /* =========================================================
           VALIDATION SUMMARY
           ========================================================= */

    .validation-summary {
        margin-bottom: 12px;
    }

</style>